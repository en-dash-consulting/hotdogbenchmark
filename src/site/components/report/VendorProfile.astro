---
/**
 * One model's entry in the report.
 *
 * An `article` with a heading, so a screen-reader user can navigate model by
 * model rather than wading through an undifferentiated grid.
 *
 * Every metric renders, including the ones that are null — those show an em
 * dash with a reason, because "not reported" and "zero" are different facts and
 * the report is careful about that everywhere else too.
 */
import VerdictBadge from './VerdictBadge.astro'
import {
  formatDuration,
  formatInteger,
  formatPercent,
  formatRate,
  formatUsd,
  NOT_REPORTED,
} from '../../lib/format.ts'
import { getModelEntry } from '../../lib/data.ts'
import type { ModelResult } from '../../../schema/run.ts'

interface Props {
  result: ModelResult
  headingLevel?: 'h3' | 'h4'
}

const { result, headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
const entry = getModelEntry(result.provider, result.modelId)

const answer = result.samples[0]?.text ?? null
const aggregate = result.aggregate

/** Metric rows. `note` explains a dash rather than leaving it unexplained. */
const metrics: Array<{ label: string; value: string; note?: string }> = [
  { label: 'Input tokens', value: formatInteger(aggregate.inputTokens?.median) },
  { label: 'Output tokens', value: formatInteger(aggregate.outputTokens?.median) },
  { label: 'Median latency', value: formatDuration(aggregate.totalMs?.median) },
  {
    label: 'Time to first token',
    value: formatDuration(aggregate.ttfbMs?.median),
    note: aggregate.ttfbMs == null ? 'not reported by this provider' : undefined,
  },
  { label: 'Throughput', value: formatRate(aggregate.tokensPerSecond?.median) },
  {
    label: 'Cost estimate',
    value: formatUsd(aggregate.costEstimateUsd),
    note: aggregate.costEstimateUsd == null ? 'no pricing on file' : undefined,
  },
  { label: 'Samples', value: formatInteger(aggregate.sampleCount) },
  {
    label: 'Instruction compliance',
    value: formatPercent(aggregate.followedInstructionRate),
  },
]
---

<article class:list={['profile', result.status === 'error' && 'profile-error']}>
  <div class="profile-head">
    <div>
      <p class="vendor">{entry?.vendor ?? result.provider}</p>
      <Heading class="model-name">{result.displayName}</Heading>
      <p class="model-id tabular">{result.modelId}</p>
    </div>
    <VerdictBadge verdict={aggregate.verdict} />
  </div>

  {
    result.status === 'error' ? (
      <div class="error-state">
        <p class="error-category">{result.error?.category.replace('_', ' ') ?? 'unavailable'}</p>
        <p class="error-message">{result.error?.message ?? 'No response was returned.'}</p>
        <p class="error-note">
          No metrics are reported for this provider in this edition. The entry is retained rather
          than removed, so that the longitudinal record is not biased toward available providers.
        </p>
      </div>
    ) : (
      <>
        {answer !== null && (
          <blockquote class="answer">
            <p>{answer}</p>
          </blockquote>
        )}

        <dl class="metrics">
          {metrics.map((metric) => (
            <div class="metric-row">
              <dt>{metric.label}</dt>
              <dd class="tabular">
                {metric.value}
                {metric.note && <span class="metric-note"> {metric.note}</span>}
              </dd>
            </div>
          ))}
        </dl>

        {result.status === 'partial' && (
          <p class="partial-note">
            Partial data: {aggregate.sampleCount} of the requested samples completed.
            {result.error && ` Last error: ${result.error.message}`}
          </p>
        )}
      </>
    )
  }
</article>

<style>
  .profile {
    padding: var(--space-m);
    background: var(--surface);
    border-top: var(--hairline) solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .profile-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .vendor {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
  }

  .model-name {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step-1);
  }

  .model-id {
    margin: var(--space-3xs) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
    overflow-wrap: anywhere;
  }

  .answer {
    margin: 0;
    padding: var(--space-2xs) var(--space-s);
    border-left: 3px solid var(--rule-strong);
    background: var(--surface-sunken);
  }

  .answer p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-strong);
  }

  .metrics {
    margin: 0;
    display: grid;
    gap: var(--space-3xs);
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-3xs);
    border-bottom: var(--hairline) solid var(--rule);
    font-size: var(--step--1);
  }

  .metric-row dt {
    color: var(--muted);
  }

  .metric-row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .metric-note {
    font-weight: 400;
    color: var(--faint);
    font-style: italic;
  }

  .error-state {
    padding: var(--space-s);
    background: var(--error-bg);
    border-left: 3px solid var(--error);
  }

  .error-category {
    margin: 0;
    font-weight: 600;
    color: var(--error);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
  }

  .error-message {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step--1);
  }

  .error-note {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .partial-note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
