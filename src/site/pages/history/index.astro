---
import Base from '../../layouts/Base.astro'
import { getQuestions } from '../../lib/data.ts'
import { routes } from '../../lib/urls.ts'

const questions = getQuestions()
---

<Base
  title="History"
  description="Verdict share, latency and token trends across every published edition."
>
  <h1>History and trends</h1>
  <p class="lede">
    Longitudinal analysis for each research question. Select a question to view verdict share over
    time, per-model trends, and recorded position changes.
  </p>

  <ul class="question-list">
    {
      questions.map((question) => (
        <li>
          <a href={routes.historyForQuestion(question.id)}>{question.reportTitle}</a>
          <p class="muted">{question.text}</p>
        </li>
      ))
    }
  </ul>

  <p><a href={routes.runs()}>Browse all editions →</a></p>
</Base>

<style>
  .lede {
    color: var(--muted);
    max-width: var(--measure);
  }

  .question-list {
    list-style: none;
    padding: 0;
    margin-block: var(--space-xl);
  }

  .question-list li + li {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: var(--hairline) solid var(--rule);
  }

  .question-list a {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .question-list p {
    margin: var(--space-3xs) 0 0;
  }
</style>
