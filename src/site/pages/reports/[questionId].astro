---
/**
 * One report per question, always showing the latest edition.
 *
 * Archive pages under /runs/<isoWeek>/ render the same components against a
 * historical run.
 */
import Base from '../../layouts/Base.astro'
import Masthead from '../../components/report/Masthead.astro'
import ExecutiveSummary from '../../components/report/ExecutiveSummary.astro'
import KpiTiles from '../../components/report/KpiTiles.astro'
import VendorProfile from '../../components/report/VendorProfile.astro'
import ResultsTable from '../../components/report/ResultsTable.astro'
import Quadrant from '../../components/report/Quadrant.astro'
import Leaderboard from '../../components/report/Leaderboard.astro'
import Scorecard from '../../components/report/Scorecard.astro'
import ConditionNav from '../../components/report/ConditionNav.astro'
import FramingSensitivity from '../../components/report/FramingSensitivity.astro'
import { CONTROL_CONDITION_ID } from '../../../schema/conditions.ts'
import {
  getLatestRun,
  getModelResults,
  getPreviousRun,
  getQuestions,
  getQuestionTextInRun,
} from '../../lib/data.ts'
import { formatEdition } from '../../lib/format.ts'
import { reportDescription } from '../../lib/seo.ts'
import { routes } from '../../lib/urls.ts'

export function getStaticPaths() {
  return getQuestions().map((question) => ({
    params: { questionId: question.id },
    props: { question },
  }))
}

const { question } = Astro.props
/** "Sandwich Certainty Quadrant" for the shipped claim; the noun comes from the registry. */
const noun = (question.claim ?? 'is a sandwich').split(' ').at(-1) ?? 'sandwich'
const quadrantTitle = `${noun.charAt(0).toUpperCase()}${noun.slice(1)} Certainty Quadrant`
const run = getLatestRun()
const results = run ? getModelResults(run, question.id) : []
const previous = run ? getPreviousRun(run.isoWeek) : null
const previousResults = previous ? getModelResults(previous, question.id) : null
const askedText = run ? getQuestionTextInRun(run, question.id) : null
---

<Base
  title={question.reportTitle}
  ogImage={question.id}
  description={reportDescription(run, question)}
>
  {
    run ? (
      <>
        <ConditionNav run={run} questionId={question.id} current={CONTROL_CONDITION_ID} />
        <Masthead question={question} run={run} questionText={askedText ?? question.text} />

        {results.length === 0 ? (
          <p class="empty">
            This question was not evaluated in the {formatEdition(run.isoWeek)} edition. See the{' '}
            <a href={routes.history()}>archive</a> for prior editions.
          </p>
        ) : (
          <>
            <KpiTiles results={results} previous={previousResults} />
            <ExecutiveSummary subject={question.subject} results={results} />

            <FramingSensitivity run={run} question={question} />

            <Quadrant results={results} title={quadrantTitle} />

            <Leaderboard
              results={results}
              previous={previousResults}
              caption={`Vendor standings — ${formatEdition(run.isoWeek)} edition`}
            />

            <section aria-labelledby="scorecards-heading">
              <h2 id="scorecards-heading">Vendor scorecards</h2>
              <div class="scorecard-grid">
                {results
                  .filter((result) => result.samples.length > 0)
                  .map((result) => (
                    <Scorecard result={result} peers={results} />
                  ))}
              </div>
            </section>

            <section aria-labelledby="profiles-heading">
              <h2 id="profiles-heading">Vendor profiles</h2>
              <div class="profile-grid">
                {results.map((result) => (
                  <VendorProfile result={result} />
                ))}
              </div>
            </section>

            <ResultsTable
              results={results}
              caption={`${question.reportTitle} — ${formatEdition(run.isoWeek)} edition`}
            />

            <p class="pdf-download">
              <a href={routes.reportPdf(question.id)} download>
                Download this report (PDF)
              </a>
              <span class="muted"> — the print edition, generated from this page.</span>
            </p>
          </>
        )}
      </>
    ) : (
      <>
        <h1>{question.reportTitle}</h1>
        <p class="empty">
          No editions have been published yet. Run <code>npm run bench -- run --mock</code> to
          generate sample data.
        </p>
      </>
    )
  }
</Base>

<style>
  /*
   * minmax(min(Xrem, 100%), 1fr) rather than minmax(Xrem, 1fr): a bare rem
   * minimum forces a track wider than the container on a 320px screen, which
   * produces horizontal scrolling that nothing on the page explains. The
   * accessibility audit caught exactly that here.
   */
  .profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-s);
  }

  .scorecard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }

  .pdf-download {
    padding: var(--space-s);
    border-top: var(--hairline) solid var(--rule);
    font-size: var(--step--1);
  }

  .empty {
    padding: var(--space-l);
    background: var(--surface);
    border-left: 3px solid var(--rule-strong);
    color: var(--muted);
  }
</style>
