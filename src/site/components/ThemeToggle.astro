---
/**
 * The theme toggle.
 *
 * A real `<button>` with `aria-pressed`, not a styled div and not a checkbox
 * pretending to be one. It follows the system preference until pressed, then
 * persists an explicit choice to localStorage.
 *
 * This is the only client JavaScript on most pages, and it is a few hundred
 * bytes. The pre-hydration script in Base.astro applies the stored value before
 * first paint; this script only handles the press.
 */
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-pressed="false"
  title="Dark theme"
>
  <span class="visually-hidden">Dark theme</span>
</button>

<script>
  const STORAGE_KEY = 'hdb-theme'
  const button = document.getElementById('theme-toggle')

  if (button) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)')

    /** Whether dark is currently showing, from the explicit choice or the system. */
    const isDark = () =>
      document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && prefersDark.matches)

    const sync = () => {
      button.setAttribute('aria-pressed', String(isDark()))
    }

    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark'
      document.documentElement.dataset.theme = next
      try {
        localStorage.setItem(STORAGE_KEY, next)
      } catch {
        // Storage unavailable (private mode, blocked site data). The toggle
        // still works for this page; it just will not be remembered.
      }
      sync()
    })

    // Track the system preference while no explicit choice has been made.
    prefersDark.addEventListener('change', sync)
    sync()
  }
</script>

<style>
  /* A round switch the size of a favicon: a ring that fills when dark is on. */
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: var(--text-strong);
    background: transparent;
    border: 2px solid var(--rule-strong);
    border-radius: 50%;
    cursor: pointer;
    transition:
      border-color 150ms var(--ease-out),
      background 150ms var(--ease-out);
  }

  .theme-toggle::before {
    content: '';
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 2px solid var(--text-strong);
    background: transparent;
    transition: background 150ms var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--text-strong);
  }

  .theme-toggle[aria-pressed='true'] {
    border-color: var(--accent-fill);
  }

  .theme-toggle[aria-pressed='true']::before {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* Fingers, not pointers. */
  @media (max-width: 52rem) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
