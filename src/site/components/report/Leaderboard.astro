---
/**
 * The ranked leaderboard.
 *
 * A semantic table with rank, movement since the prior edition, and the scores
 * that produced the ranking. Movement is conveyed by an arrow **and** a word,
 * so it survives a screen reader and forced-colors mode.
 */
import VerdictBadge from './VerdictBadge.astro'
import { MOVEMENT_GLYPH, MOVEMENT_LABEL, rankWithDeltas } from '../../lib/rank.ts'
import { formatDuration, formatInteger } from '../../lib/format.ts'
import { routes } from '../../lib/urls.ts'
import type { ModelResult } from '../../../schema/run.ts'

interface Props {
  results: ModelResult[]
  previous?: ModelResult[] | null
  caption: string
}

const { results, previous = null, caption } = Astro.props
const ranked = rankWithDeltas(results, previous)
---

<section aria-labelledby="leaderboard-heading" class="leaderboard">
  <h2 id="leaderboard-heading">Vendor standings</h2>

  <div class="table-scroll table-stack" tabindex="0" role="region" aria-label="Standings table">
    <table role="table">
      <caption>{caption}</caption>
      <thead>
        <tr role="row">
          <th scope="col" role="columnheader" class="numeric">Rank</th>
          <th scope="col" role="columnheader">Movement</th>
          <th scope="col" role="columnheader">Vendor</th>
          <th scope="col" role="columnheader">Position</th>
          <th scope="col" role="columnheader" class="numeric">Decisiveness</th>
          <th scope="col" role="columnheader" class="numeric">Efficiency</th>
          <th scope="col" role="columnheader" class="numeric">Median latency</th>
          <th scope="col" role="columnheader" class="numeric">Output tokens</th>
          <th scope="col" role="columnheader" class="numeric">Composite</th>
        </tr>
      </thead>
      <tbody>
        {
          ranked.map((entry) => (
            <tr role="row">
              <td role="cell" class="numeric rank" data-label="Rank">
                {entry.rank}
              </td>
              <td role="cell" class:list={['movement', entry.movement]} data-label="Movement">
                {MOVEMENT_GLYPH[entry.movement] && (
                  <span aria-hidden="true">{MOVEMENT_GLYPH[entry.movement]}</span>
                )}
                <span>
                  {entry.delta !== null && entry.delta !== 0
                    ? `${MOVEMENT_LABEL[entry.movement]} ${Math.abs(entry.delta)}`
                    : MOVEMENT_LABEL[entry.movement]}
                </span>
              </td>
              <th scope="row" role="rowheader">
                {entry.result.displayName}
              </th>
              <td role="cell" data-label="Position">
                <VerdictBadge verdict={entry.result.aggregate.verdict} />
              </td>
              <td role="cell" class="numeric" data-label="Decisiveness">
                {entry.decisiveness.toFixed(2)}
              </td>
              <td role="cell" class="numeric" data-label="Efficiency">
                {entry.efficiency.toFixed(2)}
              </td>
              <td role="cell" class="numeric" data-label="Median latency">
                {formatDuration(entry.result.aggregate.totalMs?.median)}
              </td>
              <td role="cell" class="numeric" data-label="Output tokens">
                {formatInteger(entry.result.aggregate.outputTokens?.median)}
              </td>
              <td role="cell" class="numeric composite" data-label="Composite">
                {entry.composite.toFixed(2)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="footnote">
    Ranked by composite score. Ties share a rank and the following rank skips; within a tie the
    order is alphabetical and carries no meaning. Movement compares against the immediately prior
    edition; a vendor with no prior appearance is marked as a new entry rather than as having risen.
    Score definitions are on the <a href={routes.methodology()}>methodology page</a>.
  </p>
</section>

<style>
  .leaderboard {
    margin-block: var(--space-xl);
  }

  .rank {
    font-weight: 600;
    color: var(--text-strong);
  }

  .composite {
    font-weight: 600;
  }

  .movement {
    display: flex;
    gap: var(--space-3xs);
    align-items: baseline;
    white-space: nowrap;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .movement.up {
    color: var(--verdict-yes);
  }

  .movement.down {
    color: var(--verdict-no);
  }

  .footnote {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: var(--space-2xs);
    max-width: var(--measure);
  }
</style>
