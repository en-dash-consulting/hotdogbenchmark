---
/**
 * The not-found page. GitHub Pages serves dist/404.html with a real 404
 * status, which is what keeps unknown paths out of the index instead of
 * being reported as soft 404s.
 */
import Base from '../layouts/Base.astro'
import { getQuestions } from '../lib/data.ts'
import { routes } from '../lib/urls.ts'

const questions = getQuestions()
const subject = questions[0]?.subject ?? 'a page'
---

<Base
  title="Not found"
  description="That page does not exist. The reports, history, and methodology are one click away."
>
  <section class="missing">
    <p class="eyebrow">404</p>
    <h1>No such page.</h1>
    <p class="lede">Not {subject} either. Here is what does exist.</p>
    <ul class="links">
      <li><a href={routes.home()}>The front page</a></li>
      {
        questions.map((question) => (
          <li>
            <a href={routes.report(question.id)}>{question.reportTitle}</a>
          </li>
        ))
      }
      <li><a href={routes.history()}>History</a></li>
      <li><a href={routes.methodology()}>How it is measured</a></li>
    </ul>
  </section>
</Base>

<style>
  .missing {
    padding-block: var(--space-2xl);
    max-width: var(--measure);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 var(--space-3xs);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--muted);
  }

  .links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .links a {
    font-family: var(--font-ui);
    font-weight: 700;
  }
</style>
