---
/**
 * The standings: one table that is both the leaderboard and the data table.
 *
 * Rank and movement on the left, the observations on the right, every model
 * once. A column whose value is identical for every model this edition is
 * left out and mentioned under the table instead; a column of 1.00s is not a
 * column, it is a sentence.
 *
 * **Fully readable with JavaScript disabled**, ordered by composite score.
 * The script is an enhancement: click-to-sort with aria-sort, filtering by
 * vendor and verdict with a live-region count, and URL-hash state so a view
 * can be shared. Nothing it adds is required to read the data.
 */
import VerdictBadge from './VerdictBadge.astro'
import { MOVEMENT_GLYPH, MOVEMENT_LABEL, rankWithDeltas } from '../../lib/rank.ts'
import { formatDuration, formatInteger, formatPercent, formatUsd } from '../../lib/format.ts'
import { uniformMeasures } from '../../lib/scores.ts'
import { getModelEntry } from '../../lib/data.ts'
import { profileAnchor, routes } from '../../lib/urls.ts'
import { modelKey } from '../../lib/sensitivity.ts'
import type { FramingShift } from '../../lib/sensitivity.ts'
import type { ModelResult } from '../../../schema/run.ts'

interface Props {
  results: ModelResult[]
  previous?: ModelResult[] | null
  caption: string
  /**
   * The framing column, when the edition ran more than the control. Passed in
   * because its meaning depends on the page: the canonical report compares
   * each model against every arm; an arm's own page compares that arm against
   * the control. Omitted when there is nothing to compare.
   */
  framing?: { label: string; cells: Record<string, FramingShift> } | null
}

const { results, previous = null, caption, framing = null } = Astro.props

const ranked = rankWithDeltas(results, previous).map((entry) => ({
  ...entry,
  vendor:
    getModelEntry(entry.result.provider, entry.result.modelId)?.vendor ?? entry.result.provider,
}))
const hasPrior = Boolean(previous && previous.length > 0)
const uniform = uniformMeasures(results)

/** The columns this edition earns. Uniform measures are not columns. */
const COLUMNS = [
  { key: 'rank', label: 'Rank', type: 'number' },
  ...(hasPrior ? [{ key: 'movement', label: 'Movement', type: 'text' }] : []),
  { key: 'model', label: 'Model', type: 'text' },
  { key: 'verdict', label: 'Position', type: 'text' },
  ...(framing ? [{ key: 'framing', label: framing.label, type: 'number' }] : []),
  ...(uniform.decisiveness ? [] : [{ key: 'decisiveness', label: 'Decisiveness', type: 'number' }]),
  ...(uniform.efficiency ? [] : [{ key: 'efficiency', label: 'Efficiency', type: 'number' }]),
  { key: 'latency', label: 'Median latency', type: 'number' },
  { key: 'tokens', label: 'Output tokens', type: 'number' },
  ...(uniform.compliance ? [] : [{ key: 'oneWord', label: 'One word', type: 'number' }]),
  { key: 'cost', label: 'Cost est.', type: 'number' },
  { key: 'composite', label: 'Composite', type: 'number' },
] as const

const show = (key: string) => COLUMNS.some((column) => column.key === key)

/** This model's framing cell, or a placeholder when the column is not shown. */
const shiftFor = (result: ModelResult): FramingShift =>
  framing?.cells[modelKey(result)] ?? { label: '—', moved: 0, comparable: 0 }

const vendors = [...new Set(ranked.map((row) => row.vendor))].sort()

/** What the table leaves out, in one sentence each. */
const omitted: string[] = []
if (uniform.decisiveness)
  omitted.push(
    `Every model scored ${uniform.values.decisiveness!.toFixed(2)} on decisiveness, so that column is not shown.`,
  )
if (uniform.efficiency)
  omitted.push(
    `Every model scored ${uniform.values.efficiency!.toFixed(2)} on efficiency, so that column is not shown.`,
  )
if (uniform.compliance)
  omitted.push(
    `Every model answered in one word ${formatPercent(uniform.values.compliance)} of the time, so that column is not shown.`,
  )
---

<div class="standings" data-results-table>
  <div class="controls" data-controls hidden>
    <div class="control">
      <label for="filter-vendor">Vendor</label>
      <select id="filter-vendor" data-filter="vendor">
        <option value="">All vendors</option>
        {vendors.map((vendor) => <option value={vendor}>{vendor}</option>)}
      </select>
    </div>
    <div class="control">
      <label for="filter-verdict">Verdict</label>
      <select id="filter-verdict" data-filter="verdict">
        <option value="">All verdicts</option>
        <option value="yes">Affirmative</option>
        <option value="no">Negative</option>
        <option value="other">Non-committal</option>
        <option value="none">No determination</option>
      </select>
    </div>
    <button type="button" data-reset>Reset</button>
    <p class="status" role="status" data-status></p>
  </div>

  <div class="table-scroll table-stack" tabindex="0" role="region" aria-label="Standings table">
    <table role="table">
      <caption>{caption}</caption>
      <thead>
        <tr role="row">
          {
            COLUMNS.map((column) => (
              <th
                scope="col"
                role="columnheader"
                class:list={[column.type === 'number' && 'numeric']}
                data-column={column.key}
                data-type={column.type}
              >
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          ranked.map((entry) => {
            const a = entry.result.aggregate
            return (
              <tr
                role="row"
                data-rank={entry.rank}
                data-movement={entry.movement}
                data-vendor={entry.vendor}
                data-verdict={a.verdict ?? 'none'}
                data-model={entry.result.displayName}
                data-decisiveness={entry.decisiveness}
                data-efficiency={entry.efficiency}
                data-latency={a.totalMs?.median ?? ''}
                data-tokens={a.outputTokens?.median ?? ''}
                data-framing={framing ? shiftFor(entry.result).moved : ''}
                data-one-word={a.followedInstructionRate ?? ''}
                data-cost={a.costEstimateUsd ?? ''}
                data-composite={entry.composite}
              >
                <td role="cell" class="numeric rank" data-label="Rank">
                  {entry.rank}
                </td>
                {hasPrior && (
                  <td role="cell" class:list={['movement', entry.movement]} data-label="Movement">
                    {MOVEMENT_GLYPH[entry.movement] && (
                      <span aria-hidden="true">{MOVEMENT_GLYPH[entry.movement]}</span>
                    )}
                    <span>
                      {entry.delta !== null && entry.delta !== 0
                        ? `${MOVEMENT_LABEL[entry.movement]} ${Math.abs(entry.delta)}`
                        : MOVEMENT_LABEL[entry.movement]}
                    </span>
                  </td>
                )}
                <th scope="row" role="rowheader">
                  <a class="model-link" href={`#${profileAnchor(entry.result)}`}>
                    {entry.result.displayName}
                  </a>
                </th>
                <td role="cell" data-label="Position">
                  <VerdictBadge verdict={a.verdict} />
                </td>
                {framing && (
                  <td
                    role="cell"
                    class:list={['framing-cell', shiftFor(entry.result).moved > 0 && 'moved']}
                    data-label={framing.label}
                  >
                    {shiftFor(entry.result).label}
                  </td>
                )}
                {show('decisiveness') && (
                  <td role="cell" class="numeric" data-label="Decisiveness">
                    {entry.decisiveness.toFixed(2)}
                  </td>
                )}
                {show('efficiency') && (
                  <td role="cell" class="numeric" data-label="Efficiency">
                    {entry.efficiency.toFixed(2)}
                  </td>
                )}
                <td role="cell" class="numeric" data-label="Median latency">
                  {formatDuration(a.totalMs?.median)}
                </td>
                <td role="cell" class="numeric" data-label="Output tokens">
                  {formatInteger(a.outputTokens?.median)}
                </td>
                {show('oneWord') && (
                  <td role="cell" class="numeric" data-label="One word">
                    {formatPercent(a.followedInstructionRate)}
                  </td>
                )}
                <td role="cell" class="numeric" data-label="Cost est.">
                  {formatUsd(a.costEstimateUsd)}
                </td>
                <td role="cell" class="numeric composite" data-label="Composite">
                  {entry.composite.toFixed(2)}
                </td>
              </tr>
            )
          })
        }
      </tbody>
    </table>
  </div>

  <p class="footnote">
    Ranked by composite score; ties share a rank and the order within a tie is alphabetical and
    carries no meaning.{' '}
    {
      hasPrior
        ? 'Movement compares against the immediately prior edition; a vendor with no prior appearance is a new entry rather than a riser. '
        : ''
    }
    Decisiveness, efficiency and the composite are constructed measures, not observations, defined on
    the <a href={routes.methodology()}>methodology page</a>.{' '}
    {
      framing && (
        <>
          <q>{framing.label}</q> is whether the system prompt moved the model's answer;{' '}
          <q>One word</q> is only whether the answer was one word, as asked. A model can hold at
          100% on the second and still ignore what it was told — see{' '}
          <a href={`${routes.methodology()}#compliance`}>one-word compliance</a>.
        </>
      )
    }
    {omitted.length > 0 && <> {omitted.join(' ')}</>}
  </p>
</div>

<script>
  // Progressive enhancement only. Everything below is additive: with this
  // script absent the table is still complete, ordered and readable.
  const root = document.querySelector<HTMLElement>('[data-results-table]')
  const table = root?.querySelector('table')
  const tbody = table?.querySelector('tbody')
  const controls = root?.querySelector<HTMLElement>('[data-controls]')
  const status = root?.querySelector<HTMLElement>('[data-status]')

  if (root && table && tbody && controls && status) {
    // The controls are hidden in the markup and revealed here, so a
    // no-JavaScript reader is never shown a filter that cannot work.
    controls.hidden = false

    const allRows = Array.from(tbody.querySelectorAll('tr'))
    const filters = Array.from(controls.querySelectorAll<HTMLSelectElement>('[data-filter]'))
    let sortKey = 'composite'
    let sortDirection: 'asc' | 'desc' = 'desc'

    const valueOf = (row: HTMLElement, key: string, type: string) => {
      const raw = row.dataset[key] ?? ''
      if (type === 'number') return raw === '' ? Number.NEGATIVE_INFINITY : Number(raw)
      return raw.toLowerCase()
    }

    function apply() {
      const vendor = filters.find((f) => f.dataset.filter === 'vendor')?.value ?? ''
      const verdict = filters.find((f) => f.dataset.filter === 'verdict')?.value ?? ''

      const header = table!.querySelector<HTMLElement>(`th[data-column="${sortKey}"]`)
      const type = header?.dataset.type ?? 'text'

      const sorted = [...allRows].sort((a, b) => {
        const left = valueOf(a, sortKey, type)
        const right = valueOf(b, sortKey, type)
        const order = left < right ? -1 : left > right ? 1 : 0
        return sortDirection === 'asc' ? order : -order
      })

      let visible = 0
      for (const row of sorted) {
        const matches =
          (!vendor || row.dataset.vendor === vendor) &&
          (!verdict || row.dataset.verdict === verdict)
        row.hidden = !matches
        if (matches) visible += 1
        tbody!.append(row)
      }

      for (const th of table!.querySelectorAll('th[data-column]')) {
        th.setAttribute(
          'aria-sort',
          th.getAttribute('data-column') === sortKey
            ? sortDirection === 'asc'
              ? 'ascending'
              : 'descending'
            : 'none',
        )
      }

      status!.textContent =
        visible === allRows.length
          ? `${visible} models shown.`
          : `${visible} of ${allRows.length} models shown.`

      // Merge with the hash rather than replace it: the framing explorer on
      // the same page keeps its own keys there.
      const state = new URLSearchParams(location.hash.slice(1))
      for (const key of ['vendor', 'verdict', 'sort']) state.delete(key)
      if (vendor) state.set('vendor', vendor)
      if (verdict) state.set('verdict', verdict)
      if (sortKey !== 'composite' || sortDirection !== 'desc') {
        state.set('sort', `${sortKey}:${sortDirection}`)
      }
      const hash = state.toString()
      history.replaceState(null, '', hash ? `#${hash}` : location.pathname + location.search)
    }

    for (const th of table.querySelectorAll<HTMLElement>('th[data-column]')) {
      th.tabIndex = 0
      th.setAttribute('role', 'columnheader')
      th.classList.add('sortable')
      const activate = () => {
        const key = th.dataset.column!
        if (key === sortKey) {
          sortDirection = sortDirection === 'asc' ? 'desc' : 'asc'
        } else {
          sortKey = key
          // Rank reads best ascending; every other number, descending.
          sortDirection = th.dataset.type === 'number' && key !== 'rank' ? 'desc' : 'asc'
        }
        apply()
      }
      th.addEventListener('click', activate)
      th.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          activate()
        }
      })
    }

    for (const filter of filters) filter.addEventListener('change', apply)
    controls.querySelector('[data-reset]')?.addEventListener('click', () => {
      for (const filter of filters) filter.value = ''
      sortKey = 'composite'
      sortDirection = 'desc'
      apply()
    })

    // Restore a shared view from the hash.
    const initial = new URLSearchParams(location.hash.slice(1))
    for (const filter of filters) {
      const value = initial.get(filter.dataset.filter!)
      if (value) filter.value = value
    }
    const sort = initial.get('sort')
    if (sort) {
      const [key, direction] = sort.split(':')
      if (key) sortKey = key
      if (direction === 'asc' || direction === 'desc') sortDirection = direction
    }
    apply()
  }
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-s);
    margin-bottom: var(--space-s);
    padding: var(--space-s);
    background: var(--surface);
    border: var(--hairline) solid var(--rule);
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .control label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  select,
  button {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-3xs) var(--space-2xs);
    background: var(--surface);
    color: var(--text);
    border: var(--hairline) solid var(--rule-strong);
    border-radius: var(--radius);
  }

  button {
    cursor: pointer;
  }

  .status {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .rank {
    font-weight: 600;
    color: var(--text-strong);
  }

  .composite {
    font-weight: 600;
  }

  /* Names get room before numbers do: a wrapped name doubles every row. */
  th[data-column='model'] {
    min-width: 13rem;
  }

  .model-link {
    color: var(--text-strong);
    text-decoration: none;
  }

  .model-link:hover {
    text-decoration: underline;
  }

  /* Stays a table cell: display: flex on a <td> takes the border-bottom with
     it and misaligns the row the moment a neighbor wraps. */
  .movement {
    white-space: nowrap;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .movement > span + span {
    margin-left: var(--space-3xs);
  }

  .movement.up {
    color: var(--verdict-yes);
  }

  .movement.down {
    color: var(--verdict-no);
  }

  /* The word does the work; the weight is a second, redundant cue. Nothing
     here is color-only, so the column reads in forced-colors mode too. */
  .framing-cell.moved {
    font-weight: 600;
    color: var(--text-strong);
  }

  th.sortable {
    cursor: pointer;
    user-select: none;
  }

  th.sortable::after {
    content: '';
    display: inline-block;
    width: 0.75em;
  }

  th[aria-sort='ascending']::after {
    content: ' ▲';
  }

  th[aria-sort='descending']::after {
    content: ' ▼';
  }

  .footnote {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: var(--space-2xs);
    max-width: var(--measure);
  }
</style>
