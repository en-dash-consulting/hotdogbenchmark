---
/**
 * The answer board: the models answer the question in front of you.
 *
 * Every sample in a run carries the time its call took and the time to its
 * first token, so a week's data can be replayed. With JavaScript, each row
 * starts thinking, its clock runs, and its word lands at the moment it
 * actually did, compressed so the slowest lands in a few seconds, then the tally fills in.
 * Then the framing switch: tell the models the answer, and watch which ones
 * flip.
 *
 * Without JavaScript the board is the control arm, fully rendered, with the
 * latency bars drawn to scale. Nothing here is invented: every word is the
 * majority sample verbatim and every bar is a recorded duration.
 */
import { CONTROL_CONDITION_ID } from '../../schema/conditions.ts'
import { getModelEntry, getQuestionResult } from '../lib/data.ts'
import { framingLabel, questionHeadline } from '../lib/prose.ts'
import { routes } from '../lib/urls.ts'
import type { BenchmarkRun, ModelResult, Verdict } from '../../schema/run.ts'
import type { QuestionEntry } from '../../schema/questions.ts'

interface Props {
  run: BenchmarkRun
  questions: QuestionEntry[]
  /** Rendered as the page's h1 when true; otherwise an h2. */
  headline?: boolean
}

const { run, questions, headline = true } = Astro.props

interface Row {
  key: string
  name: string
  vendor: string
  text: string | null
  verdict: Verdict | null
  totalMs: number | null
  ttfbMs: number | null
  thinking: number | null
  agree: number
  n: number
  error: string | null
}

/** The word a model landed on: the majority sample, verbatim. */
function rowFor(result: ModelResult): Row {
  const majority = result.aggregate.verdict
  const sample = result.samples.find((s) => s.verdict === majority) ?? result.samples[0] ?? null
  return {
    key: `${result.provider}/${result.modelId}`,
    name: result.displayName,
    vendor: getModelEntry(result.provider, result.modelId)?.vendor ?? result.provider,
    text: sample?.text.trim() ?? null,
    verdict: majority,
    totalMs: result.aggregate.totalMs?.median ?? null,
    ttfbMs: result.aggregate.ttfbMs?.median ?? null,
    thinking: sample?.usage.reasoningTokens ?? null,
    agree: result.samples.filter((s) => s.verdict === majority).length,
    n: result.samples.length,
    error: result.status === 'error' ? (result.error?.category ?? 'unavailable') : null,
  }
}

const asked = questions.filter((q) => run.results.some((cell) => cell.questionId === q.id))
const first = asked[0]
const conditions = run.conditions

/** Every cell the board can show, keyed by question and condition. */
const cells: Record<string, { prompt: string; system: string | null; rows: Row[] }> = {}
for (const question of asked) {
  for (const condition of conditions) {
    const cell = getQuestionResult(run, question.id, condition.id)
    if (!cell) continue
    cells[`${question.id}|${condition.id}`] = {
      prompt: cell.prompt,
      system: cell.systemPrompt,
      rows: cell.models.map(rowFor),
    }
  }
}

const initial = first ? cells[`${first.id}|${CONTROL_CONDITION_ID}`] : undefined
const slowest = Math.max(
  1,
  ...Object.values(cells).flatMap((c) => c.rows.map((r) => r.totalMs ?? 0)),
)

/**
 * The framing switch labels per question, from the registries: "Just ask",
 * then "Tell them a hot dog is a sandwich". Computed here once so the client
 * script relabels on a question switch without knowing what the claim is.
 */
const labels = Object.fromEntries(
  asked.map((q) => [q.id, Object.fromEntries(conditions.map((c) => [c.id, framingLabel(q, c)]))]),
)

const payload = JSON.stringify({
  questions: asked.map((q) => ({ id: q.id, subject: q.subject, text: q.text })),
  conditions: conditions.map((c) => ({ id: c.id, label: c.label })),
  labels,
  cells,
  slowest,
})

const VERDICT_WORD: Record<Verdict, string> = {
  yes: 'said yes',
  no: 'said no',
  other: 'hedged',
}

const formatMs = (ms: number | null) =>
  ms === null ? '—' : ms < 1000 ? `${Math.round(ms)} ms` : `${(ms / 1000).toFixed(1)} s`

/** The control tally, for the server-rendered state. */
const initialCounts: Record<Verdict, number> = { yes: 0, no: 0, other: 0 }
for (const row of initial?.rows ?? []) if (row.verdict) initialCounts[row.verdict] += 1
const initialTally = (['yes', 'no', 'other'] as const)
  .filter((v) => initialCounts[v] > 0)
  .map((v) => [v, initialCounts[v]] as const)

/** The line under a landed row: how long it thought, or that it did not. */
function detailFor(row: Row): string {
  const agreement = row.n > 1 ? `${row.agree} of ${row.n} runs agreed` : ''
  if (row.thinking && row.ttfbMs !== null && row.totalMs !== null) {
    const share = Math.round((row.ttfbMs / row.totalMs) * 100)
    return `Reasoned for ${formatMs(row.ttfbMs)} (${share}% of the call) on ${row.thinking} tokens, then answered${agreement ? ` · ${agreement}` : ''}`
  }
  if (row.thinking) return `${row.thinking} reasoning tokens${agreement ? ` · ${agreement}` : ''}`
  return `No reasoning, answered straight away${agreement ? ` · ${agreement}` : ''}`
}

const Heading = headline ? 'h1' : 'h2'
---

{
  first && initial && (
    <section class="board" data-board aria-labelledby="board-question">
      <script type="application/json" data-board-data set:html={payload} />

      <div class="board-head">
        <div class="subjects" role="tablist" aria-label="Question" data-subjects hidden>
          {asked.map((q) => (
            <button
              type="button"
              role="tab"
              id={`board-tab-${q.id}`}
              aria-controls="board-panel"
              data-question={q.id}
              aria-selected={q.id === first.id ? 'true' : 'false'}
              tabindex={q.id === first.id ? 0 : -1}
            >
              {q.subject.replace(/^an? /, '')}
            </button>
          ))}
        </div>

        <p class="kicker">Every week, the largest AI models are asked the question:</p>
        <Heading id="board-question" class="question">
          <span data-question-text>{questionHeadline(first)}</span>
        </Heading>
        <p class="instruction">
          <span>One word answer.</span>
          <span class="system" data-system hidden>
            <span class="system-label">System prompt</span> <q data-system-text />
          </span>
        </p>
      </div>

      <div class="controls" data-controls hidden>
        <div class="framings" role="radiogroup" aria-label="Framing" data-framings>
          {conditions.map((c) => (
            <button
              type="button"
              role="radio"
              data-condition={c.id}
              aria-checked={c.id === CONTROL_CONDITION_ID ? 'true' : 'false'}
              tabindex={c.id === CONTROL_CONDITION_ID ? 0 : -1}
              class:list={['framing', `framing-${c.id}`]}
            >
              <span data-framing-label>{labels[first.id]![c.id]}</span>
            </button>
          ))}
        </div>
        <div class="playback">
          <button type="button" class="replay" data-replay>
            Replay the week
          </button>
        </div>
      </div>

      {/* One polite live region for the whole board; nothing else announces. */}
      <p class="visually-hidden" role="status" aria-live="polite" data-announce />

      <div id="board-panel" role="tabpanel" aria-labelledby="board-question">
        <ol class="rows" data-rows>
          {initial.rows.map((row) => (
            <li
              class:list={['row', row.error && 'row-error']}
              data-row={row.key}
              data-verdict={row.verdict ?? 'none'}
            >
              <div class="who">
                <span class="name">{row.name}</span>
                <span class="vendor">{row.vendor}</span>
              </div>
              <div class="answer" data-answer>
                <span class="word" data-word>
                  {row.error ? 'no answer' : (row.text ?? '—')}
                </span>
                <span class="tag-reasoning" data-tag-reasoning hidden={!row.thinking}>
                  reasoning
                </span>
                <span class="stamp" data-stamp aria-hidden="true" />
                <span class="thinking" data-thinking aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              </div>
              <div class="timing">
                <span class="bar" aria-hidden="true">
                  <i
                    class="bar-total"
                    data-bar-total
                    style={`width:${row.totalMs ? Math.max(1, (row.totalMs / slowest) * 100) : 0}%`}
                  />
                  <i
                    class="bar-ttfb"
                    data-bar-ttfb
                    style={`width:${row.ttfbMs ? Math.max(0.5, (row.ttfbMs / slowest) * 100) : 0}%`}
                  />
                </span>
                <span class="ms tabular" data-ms>
                  {row.error ? row.error.replace('_', ' ') : formatMs(row.totalMs)}
                </span>
                <span class="detail" data-detail>
                  {row.error ? '' : detailFor(row)}
                </span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="tally" data-tally>
        {initialTally.map(([v, count]) => (
          <span class:list={['tally-item', `tally-${v}`]}>
            <b class="tabular">{count}</b> {VERDICT_WORD[v]}
          </span>
        ))}
      </div>

      <p class="board-foot">
        <span data-edition>
          Recorded {run.isoWeek.replace(/^(\d+)-W(\d+)$/, 'week $2, $1')}
          {run.isMock && ' from sample fixtures'}. Real durations, verbatim words
          <span data-speed-note />. Hatched teal is thinking; the rest is answering.
        </span>
        <a href={routes.report(first.id)} data-report-link>
          Full report →
        </a>
      </p>
    </section>
  )
}

<script>
  /**
   * The replay and the framing switch. Everything below reads the JSON the
   * page already carries; nothing is fetched. With this script absent the
   * board is the control arm, already rendered.
   */
  interface Row {
    key: string
    name: string
    vendor: string
    text: string | null
    verdict: 'yes' | 'no' | 'other' | null
    totalMs: number | null
    ttfbMs: number | null
    thinking: number | null
    agree: number
    n: number
    error: string | null
  }
  interface Cell {
    prompt: string
    system: string | null
    rows: Row[]
  }
  interface Data {
    questions: Array<{ id: string; subject: string; text: string }>
    conditions: Array<{ id: string; label: string }>
    /** Framing switch label per question id, per condition id. */
    labels: Record<string, Record<string, string>>
    cells: Record<string, Cell>
    slowest: number
  }

  const root = document.querySelector<HTMLElement>('[data-board]')
  const dataNode = root?.querySelector<HTMLScriptElement>('[data-board-data]')

  if (root && dataNode) {
    const data = JSON.parse(dataNode.textContent ?? '{}') as Data
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)
    const all = <T extends HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel))

    const rowsList = q<HTMLOListElement>('[data-rows]')!
    const tally = q('[data-tally]')!
    const questionText = q('[data-question-text]')!
    const systemWrap = q('[data-system]')!
    const systemText = q('[data-system-text]')!
    const reportLink = q<HTMLAnchorElement>('[data-report-link]')!
    const speedNote = q('[data-speed-note]')!
    const announcer = q('[data-announce]')!

    /**
     * Say one thing, politely. Landings during a replay are batched so a
     * screen reader hears a short sentence every second or so rather than a
     * word per row; the tally at the end is its own sentence.
     */
    let pending: string[] = []
    let flushTimer: number | null = null
    function announce(text: string, immediate = false) {
      if (immediate) {
        pending = []
        if (flushTimer !== null) window.clearTimeout(flushTimer)
        flushTimer = null
        announcer.textContent = text
        return
      }
      pending.push(text)
      if (flushTimer === null) {
        flushTimer = window.setTimeout(() => {
          announcer.textContent = pending.join(' ')
          pending = []
          flushTimer = null
        }, 1200)
      }
    }

    /** Roving tabindex with arrow keys for a tablist or radiogroup of buttons. */
    function arrowNav(buttons: HTMLButtonElement[], activate: (button: HTMLButtonElement) => void) {
      for (const button of buttons) {
        button.addEventListener('keydown', (event) => {
          const index = buttons.indexOf(button)
          let next: number | null = null
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown')
            next = (index + 1) % buttons.length
          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
            next = (index - 1 + buttons.length) % buttons.length
          if (event.key === 'Home') next = 0
          if (event.key === 'End') next = buttons.length - 1
          if (next === null) return
          event.preventDefault()
          buttons[next]!.focus()
          activate(buttons[next]!)
        })
      }
    }

    function setSelected(
      buttons: HTMLButtonElement[],
      attribute: string,
      isOn: (b: HTMLButtonElement) => boolean,
    ) {
      for (const button of buttons) {
        const on = isOn(button)
        button.setAttribute(attribute, String(on))
        button.tabIndex = on ? 0 : -1
      }
    }

    let questionId = data.questions[0]!.id
    let conditionId = data.conditions[0]!.id
    let timers: number[] = []
    let generation = 0

    const cellFor = (qid: string, cid: string) => data.cells[`${qid}|${cid}`]

    const formatMs = (ms: number | null) =>
      ms === null ? '—' : ms < 1000 ? `${Math.round(ms)} ms` : `${(ms / 1000).toFixed(1)} s`

    const WORD = { yes: 'said yes', no: 'said no', other: 'hedged' } as const

    /** The replay speed: compressed so the slowest answer lands in about four seconds. */
    const factor = () => Math.max(1, data.slowest / 4000)
    speedNote.textContent = factor() > 1.05 ? `, replayed at ${factor().toFixed(1)}× speed` : ''

    /** The line under a landed row: how long it thought, or that it did not. */
    function detailFor(row: Row): string {
      const agreement = row.n > 1 ? `${row.agree} of ${row.n} runs agreed` : ''
      if (row.thinking && row.ttfbMs !== null && row.totalMs !== null) {
        const share = Math.round((row.ttfbMs / row.totalMs) * 100)
        return `Reasoned for ${formatMs(row.ttfbMs)} (${share}% of the call) on ${row.thinking} tokens, then answered${agreement ? ` · ${agreement}` : ''}`
      }
      if (row.thinking)
        return `${row.thinking} reasoning tokens${agreement ? ` · ${agreement}` : ''}`
      return `No reasoning, answered straight away${agreement ? ` · ${agreement}` : ''}`
    }

    function clearTimers() {
      for (const t of timers) window.clearTimeout(t)
      timers = []
    }

    function renderTally(rows: Row[], previous?: Row[]) {
      const counts = { yes: 0, no: 0, other: 0 }
      for (const row of rows) if (row.verdict) counts[row.verdict] += 1
      const parts = (['yes', 'no', 'other'] as const)
        .filter((v) => counts[v] > 0)
        .map(
          (v) =>
            `<span class="tally-item tally-${v}"><b class="tabular">${counts[v]}</b> ${WORD[v]}</span>`,
        )
      if (previous) {
        const flipped = rows.filter((row) => {
          const before = previous.find((p) => p.key === row.key)
          return before?.verdict && row.verdict && before.verdict !== row.verdict
        }).length
        parts.push(
          `<span class="tally-item tally-flipped"><b class="tabular">${flipped}</b> changed their mind</span>`,
        )
      }
      tally.innerHTML = parts.join('')
      tally.classList.remove('tally-in')
      void tally.offsetWidth
      tally.classList.add('tally-in')
    }

    /** Fill a row's markup from a cell entry. */
    function paint(li: HTMLElement, row: Row) {
      li.dataset.verdict = row.verdict ?? 'none'
      li.classList.toggle('row-error', Boolean(row.error))
      li.querySelector('[data-word]')!.textContent = row.error ? 'no answer' : (row.text ?? '—')
      const total = li.querySelector<HTMLElement>('[data-bar-total]')!
      const ttfb = li.querySelector<HTMLElement>('[data-bar-ttfb]')!
      total.style.width = row.totalMs ? `${Math.max(1, (row.totalMs / data.slowest) * 100)}%` : '0'
      ttfb.style.width = row.ttfbMs ? `${Math.max(0.5, (row.ttfbMs / data.slowest) * 100)}%` : '0'
      li.querySelector('[data-ms]')!.textContent = row.error
        ? row.error.replace('_', ' ')
        : formatMs(row.totalMs)
      li.querySelector('[data-detail]')!.textContent = row.error ? '' : detailFor(row)
      li.querySelector<HTMLElement>('[data-tag-reasoning]')!.hidden = !row.thinking
    }

    /** Ensure the list has one <li> per row in the cell, reusing what exists. */
    function syncRows(rows: Row[]): HTMLElement[] {
      const existing = new Map(all<HTMLElement>('[data-row]').map((li) => [li.dataset.row!, li]))
      const template = existing.values().next().value as HTMLElement
      const out: HTMLElement[] = []
      for (const row of rows) {
        let li = existing.get(row.key)
        if (!li) {
          li = template.cloneNode(true) as HTMLElement
          li.dataset.row = row.key
          li.querySelector('.name')!.textContent = row.name
          li.querySelector('.vendor')!.textContent = row.vendor
          rowsList.append(li)
        }
        existing.delete(row.key)
        out.push(li)
        rowsList.append(li)
      }
      for (const orphan of existing.values()) orphan.remove()
      return out
    }

    /** Replay the control arm for the current question: think, then land. */
    function replay() {
      clearTimers()
      generation += 1
      const mine = generation
      const cell = cellFor(questionId, conditionId)
      if (!cell) return
      const lis = syncRows(cell.rows)
      root.classList.add('replaying')
      tally.innerHTML = ''

      lis.forEach((li, index) => {
        const row = cell.rows[index]!
        paint(li, row)
        if (reduced || row.error || row.totalMs === null) {
          li.classList.remove('thinking', 'first-token', 'landed', 'flip')
          li.classList.add('landed')
          return
        }
        li.classList.remove('landed', 'first-token', 'flip')
        li.classList.add('thinking')
        const ms = li.querySelector<HTMLElement>('[data-ms]')!
        const detail = li.querySelector<HTMLElement>('[data-detail]')!
        const ttfbBar = li.querySelector<HTMLElement>('[data-bar-ttfb]')!
        const started = performance.now()
        const speed = factor()
        // The thinking segment grows in scaled time up to the moment the first
        // answer token actually arrived, and the token count ticks with it.
        ttfbBar.style.transition = 'none'
        ttfbBar.style.width = '0'
        void ttfbBar.offsetWidth
        if (row.ttfbMs !== null) {
          ttfbBar.style.transition = `width ${row.ttfbMs / speed}ms linear`
          ttfbBar.style.width = `${Math.max(0.5, (row.ttfbMs / data.slowest) * 100)}%`
        }
        const tick = () => {
          if (generation !== mine || !li.classList.contains('thinking')) return
          const elapsed = (performance.now() - started) * speed
          ms.textContent = formatMs(Math.min(elapsed, row.totalMs!))
          if (row.thinking && row.ttfbMs) {
            const tokens = Math.min(row.thinking, Math.round((elapsed / row.ttfbMs) * row.thinking))
            detail.textContent = `thinking… ${tokens} tokens`
          } else {
            detail.textContent = 'waiting…'
          }
          requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
        if (row.ttfbMs !== null) {
          timers.push(
            window.setTimeout(() => {
              if (generation === mine) li.classList.add('first-token')
            }, row.ttfbMs / speed),
          )
        }
        timers.push(
          window.setTimeout(() => {
            if (generation !== mine) return
            li.classList.remove('thinking')
            li.classList.add('landed')
            ms.textContent = formatMs(row.totalMs)
            detail.textContent = detailFor(row)
            ttfbBar.style.transition = ''
            announce(`${row.name}: ${row.text ?? 'no answer'}, after ${formatMs(row.totalMs)}.`)
          }, row.totalMs / speed),
        )
      })

      const longest = Math.max(0, ...cell.rows.map((r) => (r.error ? 0 : (r.totalMs ?? 0))))
      timers.push(
        window.setTimeout(
          () => {
            if (generation !== mine) return
            root.classList.remove('replaying')
            renderTally(cell.rows)
            announce(`All answered. ${tallySentence(cell.rows)}`)
          },
          reduced ? 0 : longest / factor() + 150,
        ),
      )
    }

    /** Switch framing: flip the words that changed, hold the ones that did not. */
    function setFraming(next: string) {
      const from = cellFor(questionId, conditionId)
      const to = cellFor(questionId, next)
      if (!to || !from) return
      clearTimers()
      generation += 1
      root.classList.remove('replaying')
      conditionId = next
      setSelected(
        all<HTMLButtonElement>('[data-condition]'),
        'aria-checked',
        (b) => b.dataset.condition === next,
      )
      systemWrap.hidden = !to.system
      systemText.textContent = to.system ?? ''

      const lis = syncRows(to.rows)
      lis.forEach((li, index) => {
        const row = to.rows[index]!
        const before = from.rows.find((r) => r.key === row.key)
        const changed = Boolean(before?.verdict && row.verdict && before.verdict !== row.verdict)
        li.classList.remove('thinking', 'first-token')
        li.classList.add('landed')
        const apply = () => {
          paint(li, row)
          li.classList.toggle('flipped', changed)
        }
        if (changed && !reduced) {
          li.classList.remove('flip')
          void li.offsetWidth
          li.classList.add('flip')
          timers.push(window.setTimeout(apply, 220))
        } else {
          li.classList.remove('flip', 'flipped')
          apply()
          li.classList.toggle('flipped', changed)
        }
      })
      renderTally(to.rows, next === data.conditions[0]!.id ? undefined : from.rows)
      const changedCount = to.rows.filter((row) => {
        const before = from.rows.find((r) => r.key === row.key)
        return before?.verdict && row.verdict && before.verdict !== row.verdict
      }).length
      const label = data.conditions.find((c) => c.id === next)?.label ?? next
      announce(
        `${label}${to.system ? `, system prompt "${to.system}"` : ''}. ${tallySentence(to.rows)}${
          next === data.conditions[0]!.id ? '' : ` ${changedCount} changed their mind.`
        }`,
        true,
      )
    }

    function tallySentence(rows: Row[]): string {
      const counts = { yes: 0, no: 0, other: 0 }
      for (const row of rows) if (row.verdict) counts[row.verdict] += 1
      return `${counts.yes} said yes, ${counts.no} said no${counts.other ? `, ${counts.other} hedged` : ''}.`
    }

    function setQuestion(next: string) {
      questionId = next
      conditionId = data.conditions[0]!.id
      setSelected(
        all<HTMLButtonElement>('[data-question]'),
        'aria-selected',
        (b) => b.dataset.question === next,
      )
      setSelected(
        all<HTMLButtonElement>('[data-condition]'),
        'aria-checked',
        (b) => b.dataset.condition === conditionId,
      )
      for (const button of all<HTMLButtonElement>('[data-condition]')) {
        const label = button.querySelector('[data-framing-label]')!
        label.textContent = data.labels[next]?.[button.dataset.condition!] ?? label.textContent
      }
      const question = data.questions.find((x) => x.id === next)!
      questionText.textContent = question.text.replace(/ One word answer\.$/, '')
      announce(`Now asking: ${question.text}`, true)
      systemWrap.hidden = true
      reportLink.href = reportLink.href.replace(/reports\/[^/]+\//, `reports/${next}/`)
      for (const li of all('[data-row]')) li.classList.remove('flipped', 'flip')
      replay()
    }

    const questionTabs = all<HTMLButtonElement>('[data-question]')
    const framingRadios = all<HTMLButtonElement>('[data-condition]')
    for (const button of questionTabs) {
      button.addEventListener('click', () => setQuestion(button.dataset.question!))
    }
    for (const button of framingRadios) {
      button.addEventListener('click', () => setFraming(button.dataset.condition!))
    }
    arrowNav(questionTabs, (button) => setQuestion(button.dataset.question!))
    arrowNav(framingRadios, (button) => setFraming(button.dataset.condition!))
    q('[data-replay]')!.addEventListener('click', () => {
      for (const li of all('[data-row]')) li.classList.remove('flipped', 'flip')
      setFraming(data.conditions[0]!.id)
      replay()
    })

    // Reveal the controls only once they can work.
    q('[data-controls]')!.hidden = false
    q('[data-subjects]')!.hidden = data.questions.length < 2

    // The opening act.
    replay()
  }
</script>

