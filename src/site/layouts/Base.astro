---
/**
 * The layout every page uses.
 *
 * Structure is landmark-first: skip link, header/nav, main, footer. Exactly one
 * h1 per page, supplied by the page rather than by this layout.
 *
 * The theme script is inline and pre-hydration on purpose — see the comment on
 * it below.
 */
import '../styles/global.css'
import { getLatestRun, getSite } from '../lib/data.ts'
import { siteNameCaps } from '../../schema/site.ts'
import { nextEdition, nextEditionLine } from '../lib/next-edition.ts'
import { formatDate, formatEdition } from '../lib/format.ts'
import { REPO_URL, RUN_YOUR_OWN_ENABLED, href, routes } from '../lib/urls.ts'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title: string
  description: string
  /** Rendered in the <title> as "<title> — HOTDOG BENCHMARK". */
  bareTitle?: boolean
  /** Name of a card under /og/, without the extension. Defaults to the site card. */
  ogImage?: string
  /** Drop the top padding of main, for a page that opens with a full-bleed band. */
  flush?: boolean
  /**
   * Structured data for the page, emitted as one application/ld+json block.
   * Built in src/site/lib/seo.ts from the same data as the page, so it can
   * only say what the page says.
   */
  jsonLd?: object | object[] | null
}

const {
  title,
  description,
  bareTitle = false,
  ogImage = 'default',
  flush = false,
  jsonLd = null,
} = Astro.props

/**
 * JSON inside a script element ends at the first "</script>", whatever the
 * JSON thinks. Escaping "<" keeps a model name or a question containing one
 * from closing the block early.
 */
const jsonLdBlocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((block) =>
  JSON.stringify(block).replace(/</g, '\\u003c'),
)

/** Who publishes this, what it is called, and where its code lives: site.json. */
const site = getSite()
const SITE_NAME = siteNameCaps(site)
const fullTitle = bareTitle ? title : `${title} — ${SITE_NAME}`

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href
// OpenGraph requires an absolute URL; a relative one is silently ignored by
// every card validator, which is a slow way to find out it is wrong.
const ogImageUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/${ogImage}.png`,
  Astro.site ?? 'http://localhost:4321',
).href
const latest = getLatestRun()
const upcoming = nextEditionLine(nextEdition(latest?.finishedAt ?? null, site.schedule, new Date()))

/**
 * Google Analytics, only when a measurement ID is supplied at build time
 * (PUBLIC_GA_MEASUREMENT_ID, a repository variable on the deploy). A fork
 * gets no analytics unless it sets its own. The ID is validated so a stray
 * value cannot inject markup.
 */
const gaId = /^G-[A-Z0-9]{4,}$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '')
  ? (import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string)
  : null
const gaSnippet = gaId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${gaId}',{anonymize_ip:true});`
  : ''

/** The upright files are preloaded; italics load only where an <em> needs them. */
const PRELOADED_FONTS = [
  href('fonts/montserrat-normal-latin.woff2'),
  href('fonts/merriweather-normal-latin.woff2'),
]
const LATIN_RANGE =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
const fontFace = (family: string, style: string, weight: string, file: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:optional;src:url('${href(`fonts/${file}`)}') format('woff2');unicode-range:${LATIN_RANGE}}`
const FONT_FACES = [
  fontFace('Montserrat', 'normal', '400 900', 'montserrat-normal-latin.woff2'),
  fontFace('Montserrat', 'italic', '400 900', 'montserrat-italic-latin.woff2'),
  fontFace('Merriweather', 'normal', '300 700', 'merriweather-normal-latin.woff2'),
  fontFace('Merriweather', 'italic', '400', 'merriweather-italic-latin.woff2'),
].join('')

/**
 * `also`: further sections a nav item is current for. A question's
 * week-by-week history is reached from Editions, so Editions is current there.
 */
const NAV: Array<{ href: string; label: string; also?: string[] }> = [
  { href: routes.reports(), label: 'Reports' },
  { href: routes.runs(), label: 'Editions', also: [routes.historyForQuestion('')] },
  // Only present when the deferred feature is switched on at build time.
  ...(RUN_YOUR_OWN_ENABLED ? [{ href: routes.runYourOwn(), label: 'Run your own' }] : []),
  { href: routes.methodology(), label: 'Methodology' },
  { href: routes.howItWorks(), label: 'How it works' },
  { href: routes.about(), label: 'About' },
]

/**
 * Trailing slashes are normalized so `/runs` and `/runs/` both match, and a
 * section stays current on its children: Reports on every report, Editions on
 * every edition and every question's history. The home page matches only
 * itself.
 */
const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const current = normalize(Astro.url.pathname)
const home = normalize(routes.home())
const under = (href: string) => {
  const target = normalize(href)
  return target === current || (target !== home && current.startsWith(`${target}/`))
}
const isCurrent = (item: { href: string; also?: string[] }) =>
  under(item.href) || (item.also ?? []).some(under)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#001769" />

    {/* The publisher's mark, from site.json; the same icon set as its other properties. */}
    <link rel="icon" href={href('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={href(site.mark.src)} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <link rel="canonical" href={canonical} />

    {
      gaId && (
        <>
          <script
            is:inline
            async
            data-analytics
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          />
          <script is:inline data-analytics set:html={gaSnippet} />
        </>
      )
    }

    {
      /* The type, self-hosted and preloaded: no third-party request,
         and the two upright files are in flight before the stylesheet asks
         for them. font-display: optional means a font that has not arrived by
         first paint is skipped for that page view rather than swapped in
         later, so the layout never shifts; with the preload it is nearly
         always there in time, and it is cached for every page after. */
    }
    {
      PRELOADED_FONTS.map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }
    <style set:html={FONT_FACES}></style>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE_NAME}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/json"
      title="Weekly editions"
      href={routes.feedJson()}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Weekly editions"
      href={routes.feedRss()}
    />

    {jsonLdBlocks.map((text) => <script type="application/ld+json" set:html={text} />)}

    {
      /*
      Runs before first paint, which is the entire point. Applying a stored
      theme after hydration produces a flash of the wrong theme on every page
      load, and there is no way to avoid that from an external script. It is
      deliberately tiny and wrapped in try/catch because localStorage throws
      outright in some privacy modes.
    */
    }
    <script is:inline>
      try {
        const stored = localStorage.getItem('hdb-theme')
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored
        }
      } catch {
        /* No stored preference available; the system preference applies. */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="masthead">
      <div class="container masthead-inner">
        <a class="wordmark" href={routes.home()}>
          <img
            class="brand-mark"
            src={href(site.mark.src)}
            alt={site.mark.alt}
            width="44"
            height="44"
          />
          <span class="wordmark-name">
            {site.wordmark.map((line) => <span class="wordmark-line">{line}</span>)}
          </span>
        </a>

        <div class="masthead-controls">
          <nav aria-label="Primary">
            <ul class="nav-list">
              {
                NAV.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <ThemeToggle />
        </div>
      </div>
      <div class="brand-line"></div>
    </header>

    <main id="main" class:list={['container', flush && 'flush']}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="rule"></div>
        <div class="footer-grid">
          <p class="footer-meta">
            {
              latest ? (
                <>
                  Data as of <strong>{formatEdition(latest.isoWeek)}</strong>, published{' '}
                  {formatDate(latest.finishedAt)}. {upcoming}
                  {latest.isMock && <span class="footer-mock"> Sample data.</span>}
                </>
              ) : (
                <>No editions published yet.</>
              )
            }
          </p>
          <p class="footer-links">
            <a href={REPO_URL}>Source on GitHub</a>
            <span aria-hidden="true"> · </span>
            <a href={routes.methodology()}>Methodology</a>
            <span aria-hidden="true"> · </span>
            <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT license</a>
            <span aria-hidden="true"> · </span>
            <a href={routes.feedRss()} type="application/rss+xml" rel="alternate"> RSS </a>
            <span aria-hidden="true"> · </span>
            <a href={routes.feedJson()} type="application/json" rel="alternate"> JSON feed </a>
            {
              site.credits.map((credit) => (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={credit.href}>Built with {credit.label}</a>
                </>
              ))
            }
          </p>
        </div>
        <p class="footer-note">
          {site.footerNote} See <a href={routes.about()}>About</a>.
        </p>
        {
          site.more && (
            <p class="footer-apps">
              {site.more.lead}{' '}
              {site.more.links.map((link, index) => (
                <>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead {
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-block: var(--space-s);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    text-decoration: none;
    color: inherit;
  }

  .brand-mark {
    display: block;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
  }

  .wordmark-name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .wordmark-line:last-child {
    color: var(--accent);
  }

  .brand-line {
    height: 3px;
    background: linear-gradient(90deg, var(--accent-fill) 0%, #7bffea 100%);
  }

  .masthead-controls {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-strong);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 999px;
    transition:
      background 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  .nav-list a:hover {
    background: var(--surface-sunken);
  }

  /* The current page is a filled pill, not a color change alone. */
  .nav-list a[aria-current='page'] {
    background: var(--primary);
    color: var(--on-primary);
  }

  main {
    padding-block: var(--space-xl) var(--space-2xl);
    min-height: 60vh;
  }

  main.flush {
    padding-top: 0;
  }

  .site-footer {
    background: var(--surface);
    padding-block: var(--space-l) var(--space-xl);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .footer-meta,
  .footer-links {
    margin: 0;
  }

  .footer-mock {
    color: var(--accent);
    font-weight: 600;
  }

  .footer-note {
    margin: var(--space-m) 0 0;
    max-width: var(--measure);
    color: var(--faint);
  }

  .footer-apps {
    margin: var(--space-s) 0 0;
    color: var(--faint);
  }

  /*
   * Narrow screens: the mark and the toggle share the top row, and the nav
   * becomes one scrolling row of pills underneath. No JavaScript, no
   * hamburger, nothing hidden.
   */
  @media (max-width: 52rem) {
    /* Two rows of header is too much to pin on a phone; it scrolls away. */
    .masthead {
      position: static;
    }

    .masthead-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      row-gap: var(--space-xs);
      min-width: 0;
    }

    .wordmark,
    .wordmark-name {
      min-width: 0;
    }

    .wordmark-line {
      overflow-wrap: anywhere;
    }

    .masthead-controls {
      display: contents;
    }

    .masthead-controls .theme-toggle {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
    }

    /*
     * The row scrolls, and says so: a shadow on whichever edge has more
     * behind it, drawn with background-attachment so it fades as the reader
     * reaches the end. No script, and nothing to reveal that a pointer
     * could not already reach.
     */
    .masthead-controls nav {
      grid-row: 2;
      grid-column: 1 / -1;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      margin-inline: calc(-1 * var(--space-m));
      padding-inline: var(--space-m);
      --scroll-shadow: color-mix(in srgb, var(--text-strong) 28%, transparent);
      background:
        linear-gradient(90deg, var(--bg) 40%, transparent) 0 0 / 3rem 100%,
        linear-gradient(270deg, var(--bg) 40%, transparent) 100% 0 / 3rem 100%,
        radial-gradient(farthest-side at 0 50%, var(--scroll-shadow), transparent) 0 0 / 1.25rem
          100%,
        radial-gradient(farthest-side at 100% 50%, var(--scroll-shadow), transparent) 100% 0 /
          1.25rem 100%;
      background-repeat: no-repeat;
      background-attachment: local, local, scroll, scroll;
    }

    .nav-list li {
      scroll-snap-align: start;
    }

    /* The system palette has no shadow. A hairline under the row marks it as
       a strip of its own, which is what the reader needs to know. */
    @media (forced-colors: active) {
      .masthead-controls nav {
        background: none;
        border-bottom: 1px solid CanvasText;
      }
    }

    .masthead-controls nav::-webkit-scrollbar {
      display: none;
    }

    .nav-list {
      flex-wrap: nowrap;
      width: max-content;
      padding-bottom: 2px;
    }
  }
</style>
