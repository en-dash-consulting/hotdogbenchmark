---
/**
 * A verdict, conveyed three ways: by text, by a glyph, and by color.
 *
 * Color alone would fail WCAG 1.4.1 and would be unreadable in forced-colors
 * mode. The glyph is a plain typographic character rather than an icon font or
 * an emoji — the visual brief forbids anything that reads as playful, and an
 * emoji check mark would be exactly that.
 */
import type { Verdict } from '../../../schema/run.ts'

interface Props {
  verdict: Verdict | null
  size?: 'normal' | 'large'
}

const { verdict, size = 'normal' } = Astro.props

const PRESENTATION: Record<Verdict, { label: string; glyph: string }> = {
  yes: { label: 'Affirmative', glyph: '+' },
  no: { label: 'Negative', glyph: '−' },
  other: { label: 'Non-committal', glyph: '~' },
}

const presentation = verdict ? PRESENTATION[verdict] : null
---

{
  presentation ? (
    <span class:list={['verdict-badge', `verdict-${verdict}`, size]}>
      <span class="glyph" aria-hidden="true">
        {presentation.glyph}
      </span>
      <span class="label">{presentation.label}</span>
    </span>
  ) : (
    <span class:list={['verdict-badge', 'verdict-none', size]}>
      <span class="label">No determination</span>
    </span>
  )
}

<style>
  .verdict-badge {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3xs);
    padding: 0.1em 0.5em;
    border: var(--hairline) solid currentcolor;
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .verdict-badge.large {
    font-size: var(--step-0);
  }

  .glyph {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .verdict-yes {
    color: var(--verdict-yes);
    background: var(--verdict-yes-bg);
  }

  .verdict-no {
    color: var(--verdict-no);
    background: var(--verdict-no-bg);
  }

  .verdict-other {
    color: var(--verdict-other);
    background: var(--verdict-other-bg);
  }

  .verdict-none {
    color: var(--muted);
    background: var(--surface-sunken);
  }
</style>
