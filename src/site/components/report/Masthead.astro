---
/**
 * The report masthead.
 *
 * Everything a subscription research note puts above the fold: title, edition,
 * a "prepared by" line, a document reference number, and the research question
 * set out as a formal callout.
 *
 * When the underlying run is mock data this says so, prominently. Publishing
 * simulated numbers unlabelled would undermine the one thing this project is
 * actually serious about.
 */
import { documentReference, formatDate, formatEdition } from '../../lib/format.ts'
import { getSite } from '../../lib/data.ts'
import { preparedBy } from '../../../schema/site.ts'
import { creditLine } from '../../../schema/questions.ts'
import type { BenchmarkRun, RunCondition } from '../../../schema/run.ts'
import type { QuestionEntry } from '../../../schema/questions.ts'

interface Props {
  question: QuestionEntry
  run: BenchmarkRun
  /** Shown on archive pages. */
  archived?: boolean
  questionText?: string
  /** The non-control arm this page reports, when it is one. */
  condition?: RunCondition | null
  /** The system prompt actually sent under that arm, for this question. */
  systemPrompt?: string | null
  /** The print edition, offered where a research note offers it: at the top. */
  pdfHref?: string | null
  /** The page's own address, shown as text so it can be copied with scripts off. */
  shareUrl?: string | null
}

const {
  question,
  run,
  archived = false,
  questionText,
  condition = null,
  systemPrompt = null,
  pdfHref = null,
  shareUrl = null,
} = Astro.props
const asked = questionText ?? question.text
const site = getSite()
const credit = creditLine(question)
---

<header class="report-masthead">
  <p class="kicker">{site.name}</p>
  <h1>{question.reportTitle}</h1>

  <dl class="meta">
    <div>
      <dt>Edition</dt>
      <dd>{formatEdition(run.isoWeek)}</dd>
    </div>
    <div>
      <dt>Published</dt>
      <dd>{formatDate(run.finishedAt)}</dd>
    </div>
    <div>
      <dt>Prepared by</dt>
      <dd>{preparedBy(site)}</dd>
    </div>
    {
      credit && (
        <div>
          <dt>Question</dt>
          <dd>
            {question.contributor?.url ? (
              <>
                Sent in by{' '}
                <a target="_blank" href={question.contributor.url} rel="nofollow noopener">
                  {question.contributor.name}
                </a>
              </>
            ) : (
              credit
            )}
          </dd>
        </div>
      )
    }
    <div>
      <dt>Document</dt>
      <dd class="tabular">
        {documentReference(run.runId, question.id)}
        {condition && <span class="doc-suffix">/{condition.id.toUpperCase().slice(0, 3)}</span>}
      </dd>
    </div>
    {
      condition && (
        <div>
          <dt>Condition</dt>
          <dd>{condition.label}</dd>
        </div>
      )
    }
    {
      (shareUrl || pdfHref) && (
        <div class="share" data-share>
          <dt>Share</dt>
          <dd>
            {shareUrl && (
              <a class="share-url" href={shareUrl} data-share-url>
                {shareUrl.replace(/^https?:\/\//, '')}
              </a>
            )}
            {shareUrl && (
              <button type="button" class="share-copy" data-share-copy hidden>
                Copy link
              </button>
            )}
            {pdfHref && (
              <a class="share-pdf pdf-download" href={pdfHref} download>
                PDF
              </a>
            )}
            <span class="visually-hidden" role="status" data-share-status />
          </dd>
        </div>
      )
    }
  </dl>

  {
    run.isMock && (
      <p class="notice" role="note">
        <strong>Sample data.</strong> This edition was generated from recorded fixtures rather than
        live provider calls. The figures below are illustrative and describe no real model.
      </p>
    )
  }

  {
    archived && (
      <p class="notice archived" role="note">
        <strong>Archived edition.</strong> This is a historical record. The current edition is
        published on the report page.
      </p>
    )
  }

  {
    condition && (
      <p class="notice condition" role="note">
        <strong>{condition.label} framing.</strong> {condition.description} Figures on this page
        describe the field under that framing; the control report is the canonical edition.
      </p>
    )
  }

  <blockquote class="research-question">
    {
      systemPrompt && (
        <>
          <p class="research-question-label">System prompt</p>
          <p class="research-question-system">{systemPrompt}</p>
        </>
      )
    }
    <p class="research-question-label">Research question</p>
    <p class="research-question-text">{asked}</p>
  </blockquote>
</header>

<script>
  /**
   * A copy button, only where the clipboard exists. Without it the address is
   * a link whose text is the address: select it, copy it, paste it.
   */
  for (const share of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const url = share.querySelector<HTMLAnchorElement>('[data-share-url]')
    const button = share.querySelector<HTMLButtonElement>('[data-share-copy]')
    const status = share.querySelector<HTMLElement>('[data-share-status]')
    if (!url || !button || !status || !navigator.clipboard) continue
    button.hidden = false
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url.href)
        button.textContent = 'Copied'
        status.textContent = 'Link copied to the clipboard.'
      } catch {
        status.textContent = 'Could not copy; select the address and copy it.'
      }
      window.setTimeout(() => {
        button.textContent = 'Copy link'
      }, 2000)
    })
  }
</script>

<style>
  .share dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* Flex items, not inline text, so each is a real target: 28px tall at least. */
  .share-url,
  .share-pdf {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
  }

  .share-url {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .share-copy {
    font: inherit;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    min-height: 1.75rem;
    padding: 0 var(--space-2xs);
    border: 2px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
  }

  .share-copy:hover {
    border-color: var(--text-strong);
  }

  .share-pdf {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .report-masthead {
    margin-bottom: var(--space-xl);
  }

  .kicker {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 var(--space-2xs);
  }

  h1 {
    margin-bottom: var(--space-m);
    max-width: 22ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin: 0 0 var(--space-m);
    padding: var(--space-s) 0;
    border-top: var(--hairline) solid var(--rule);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .meta div {
    min-width: 0;
  }

  dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: var(--space-3xs);
  }

  dd {
    margin: 0;
    font-weight: 600;
    color: var(--text-strong);
  }

  .notice {
    padding: var(--space-2xs) var(--space-s);
    border-left: 3px solid var(--accent);
    background: var(--surface-sunken);
    font-size: var(--step--1);
    margin: 0 0 var(--space-m);
  }

  .notice.archived {
    border-left-color: var(--muted);
  }

  .notice.condition {
    border-left-color: var(--text-strong);
  }

  .doc-suffix {
    color: var(--muted);
    font-weight: 400;
  }

  .research-question-system {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--text);
    margin: 0 0 var(--space-s);
  }

  .research-question {
    margin: 0;
    padding: var(--space-m);
    background: var(--surface);
    border-left: 3px solid var(--text-strong);
  }

  .research-question-label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 var(--space-2xs);
  }

  .research-question-text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text-strong);
    margin: 0;
  }
</style>
