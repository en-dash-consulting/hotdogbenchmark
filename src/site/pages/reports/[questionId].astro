---
/**
 * One report per question, always showing the latest edition.
 *
 * One comparison and one roster. The comparison is the KPI row, the summary,
 * the framing section, the quadrant and the standings; the roster is one card
 * per vendor. Every model appears in the standings and in its card, and
 * nowhere else twice. On a phone the standings and the roster fold.
 *
 * Archive pages under /runs/<isoWeek>/ render the same components against a
 * historical run.
 */
import Base from '../../layouts/Base.astro'
import QuestionSwitcher from '../../components/QuestionSwitcher.astro'
import Masthead from '../../components/report/Masthead.astro'
import ExecutiveSummary from '../../components/report/ExecutiveSummary.astro'
import KpiTiles from '../../components/report/KpiTiles.astro'
import VendorCard from '../../components/report/VendorCard.astro'
import Standings from '../../components/report/Standings.astro'
import Quadrant from '../../components/report/Quadrant.astro'
import Fold from '../../components/report/Fold.astro'
import ConditionNav from '../../components/report/ConditionNav.astro'
import FramingSensitivity from '../../components/report/FramingSensitivity.astro'
import { CONTROL_CONDITION_ID } from '../../../schema/conditions.ts'
import { framingColumnAcross, questionFieldShift } from '../../lib/sensitivity.ts'
import {
  getLatestRun,
  getModelResults,
  getPreviousRun,
  getQuestions,
  getQuestionTextInRun,
} from '../../lib/data.ts'
import { formatEdition } from '../../lib/format.ts'
import { count, breadcrumbJsonLd, reportDescription } from '../../lib/seo.ts'
import { routes } from '../../lib/urls.ts'

export function getStaticPaths() {
  return getQuestions().map((question) => ({
    params: { questionId: question.id },
    props: { question },
  }))
}

const { question } = Astro.props
const questions = getQuestions()
/** "Sandwich Certainty Quadrant" for the shipped claim; the noun comes from the registry. */
const noun = (question.claim ?? 'is a sandwich').split(' ').at(-1) ?? 'sandwich'
const quadrantTitle = `${noun.charAt(0).toUpperCase()}${noun.slice(1)} Certainty Quadrant`
const run = getLatestRun()
const results = run ? getModelResults(run, question.id) : []
const answering = results.filter((result) => result.samples.length > 0)
const previous = run ? getPreviousRun(run.isoWeek) : null
const previousResults = previous ? getModelResults(previous, question.id) : null
const askedText = run ? getQuestionTextInRun(run, question.id) : null
// What the system prompts did, surfaced in the KPI row and the table rather
// than only in the framing section further down the page.
const framingColumn = run ? framingColumnAcross(run, question.id) : null
const fieldShift = run ? questionFieldShift(run, question.id) : null
const framingTile =
  fieldShift && fieldShift.comparable > 0
    ? {
        held: fieldShift.held,
        comparable: fieldShift.comparable,
        label: 'Held under framing',
        sub: 'kept their answer when told otherwise',
      }
    : null
---

<Base
  title={question.reportTitle}
  ogImage={question.id}
  description={reportDescription(run, question)}
  jsonLd={breadcrumbJsonLd(Astro.site ?? new URL('http://localhost:4321'), [
    { name: 'Home', path: routes.home() },
    { name: 'Reports', path: routes.reports() },
    { name: question.reportTitle, path: routes.report(question.id) },
  ])}
>
  {
    run ? (
      <>
        <QuestionSwitcher
          questions={questions}
          current={question.id}
          hrefFor={(id) => routes.report(id)}
        />
        <ConditionNav run={run} questionId={question.id} current={CONTROL_CONDITION_ID} />
        <Masthead
          question={question}
          run={run}
          questionText={askedText ?? question.text}
          pdfHref={routes.reportPdf(question.id)}
          shareUrl={new URL(routes.report(question.id), Astro.site ?? 'http://localhost:4321').href}
        />

        {results.length === 0 ? (
          <p class="empty">
            This question was not evaluated in the {formatEdition(run.isoWeek)} edition. Earlier
            editions are in <a href={routes.runs()}>the archive</a>.
          </p>
        ) : (
          <>
            <KpiTiles results={results} previous={previousResults} framing={framingTile} />
            <ExecutiveSummary subject={question.subject} results={results} />

            <FramingSensitivity run={run} question={question} />

            <Quadrant results={results} title={quadrantTitle} />

            <Fold
              id="standings-heading"
              title="Vendor standings"
              hint={`${count(answering.length, 'model')} ranked by composite score, with latency, tokens and cost`}
            >
              <Standings
                results={results}
                previous={previousResults}
                caption={`Vendor standings — ${formatEdition(run.isoWeek)} edition`}
                framing={framingColumn}
              />
            </Fold>

            <Fold
              id="profiles-heading"
              title="Vendor profiles"
              hint={`One card per model: the verbatim answer, the shape of its numbers, and what they cost`}
            >
              <div class="profile-grid">
                {results.map((result) => (
                  <VendorCard result={result} peers={results} />
                ))}
              </div>
            </Fold>
          </>
        )}
      </>
    ) : (
      <>
        <h1>{question.reportTitle}</h1>
        <p class="empty">
          No editions have been published yet. Run <code>npm run bench -- run --mock</code> to
          generate sample data.
        </p>
      </>
    )
  }
</Base>

<style>
  /*
   * minmax(min(Xrem, 100%), 1fr) rather than minmax(Xrem, 1fr): a bare rem
   * minimum forces a track wider than the container on a 320px screen, which
   * produces horizontal scrolling that nothing on the page explains. The
   * accessibility audit caught exactly that here.
   */
  .profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-s);
  }

  .empty {
    padding: var(--space-l);
    background: var(--surface);
    border-left: 3px solid var(--rule-strong);
    color: var(--muted);
  }
</style>
