{
  "name": "hotdogbenchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A weekly cross-provider LLM benchmark that asks every major model whether a hot dog is a sandwich, and publishes the results as a straight-faced industry analyst report.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/og-images.mjs && node scripts/pdf.mjs",
    "build:og": "node scripts/og-images.mjs",
    "build:site": "astro build",
    "build:pdf": "node scripts/pdf.mjs",
    "bench": "node src/cli.ts",
    "bench:smoke": "node src/cli.ts smoke",
    "bench:record": "node src/cli.ts record",
    "data:index": "node src/cli.ts data index",
    "data:validate": "node src/cli.ts data validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "node scripts/a11y.mjs",
    "test:audit": "node scripts/a11y-audit.mjs",
    "test:responsive": "node scripts/responsive.mjs dist --out .responsive",
    "test:budget": "node scripts/js-budget.mjs",
    "test:lighthouse": "lhci autorun",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^7.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.7.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
