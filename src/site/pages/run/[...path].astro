---
/**
 * The bring-your-own-keys benchmark runner.
 *
 * Emitted only when RUN_YOUR_OWN_ENABLED is true at build time. When the flag
 * is off, getStaticPaths returns nothing and the page is absent from dist/ —
 * not hidden with CSS, not returning a 404 page, simply not built.
 *
 * It is a **rest route** (`[...path]`) rather than a plain `run.astro` for one
 * specific reason: Astro only calls getStaticPaths for dynamic routes. A static
 * page ignores it entirely and is emitted unconditionally, which is exactly the
 * bug the build test caught when this was `run.astro`.
 *
 * This is the only page on the site that ships a meaningful JavaScript bundle,
 * which is why the site-wide budget check excludes it.
 */
import Base from '../../layouts/Base.astro'
import { getModels, getSite } from '../../lib/data.ts'
import { REPO_URL, RUN_YOUR_OWN_ENABLED, routes } from '../../lib/urls.ts'

export function getStaticPaths() {
  // An empty list means Astro emits no page at all for this route.
  return RUN_YOUR_OWN_ENABLED ? [{ params: { path: undefined } }] : []
}

/**
 * Where the proxy lives. Without it configured the page still renders and still
 * explains itself; sign-in simply never succeeds.
 */
const proxyOrigin = import.meta.env.PROXY_ORIGIN ?? ''
const models = getModels()
---

<Base
  title="Run your own"
  description={`Run the ${getSite().name} on your own question, with your own provider keys.`}
>
  <div class="prose">
    <h1>Run your own benchmark</h1>

    <p class="lede">
      Sign in, supply your own provider keys, ask your own question, and get a full report rendered
      in your browser.
    </p>

    <p>
      The runner is the same code that produces the weekly editions — the same adapters, the same
      sampling, the same classification. Only the <code>fetch</code> differs, routing through a proxy
      so your keys never reach a provider from an origin you do not control.
    </p>

    <h2>What happens to your keys</h2>

    <ul class="commitments">
      <li>
        <strong>Held in this tab's session storage only.</strong> Never in a cookie, never in local storage,
        never persisted past the tab.
      </li>
      <li><strong>Cleared on sign-out</strong>, when the tab closes, or on demand.</li>
      <li>
        <strong>Sent only to the proxy origin</strong>, over TLS, once per request, and never to any
        other host.
      </li>
      <li>
        <strong>Never stored server-side and never logged.</strong> The proxy records a user id, a provider,
        a status and a duration. Not headers, not keys, not prompts, not bodies.
      </li>
      <li>
        <strong>Never written to <code>data/</code>.</strong> Your runs are yours; they are not published
        and do not enter the archive.
      </li>
    </ul>

    <p>
      The full threat model, including the residual risks, is in{' '}
      <a target="_blank" rel="noopener" href={`${REPO_URL}/blob/main/docs/proxy.md`}
        >docs/proxy.md</a
      >. If a key is too valuable to put in a browser at all, use the CLI instead — that is the
      honest recommendation, and it is what the published editions use.
    </p>

    <details class="cli-alternative">
      <summary>Run it locally instead</summary>
      <pre><code>git clone {REPO_URL}.git
cd hotdogbenchmark && npm install
cp .env.example .env      # add your keys
npm run bench -- run</code></pre>
      <p>
        Edit <code>questions.json</code> to ask something else. The{' '}
        <a href={routes.howItWorks()}>how it works</a> page explains the pipeline.
      </p>
    </details>
  </div>

  <section
    class="run-app"
    data-run-app
    data-proxy-origin={proxyOrigin}
    data-models={JSON.stringify(models)}
    aria-labelledby="run-heading"
  >
    <h2 id="run-heading">Run a benchmark</h2>

    <div class="identity-row">
      <p id="identity" class="muted">Checking sign-in…</p>
      <button type="button" id="sign-in" hidden>Sign in with {getSite().publisher.name}</button>
      <button type="button" id="sign-out" hidden>Sign out</button>
    </div>

    <form id="run-form" hidden>
      <fieldset>
        <legend>Provider keys</legend>
        <p class="field-note">
          Held in this tab only, cleared when it closes or when you sign out. Leave a field blank to
          skip that provider.
        </p>
        <div id="key-fields" class="key-fields"></div>
        <button type="button" id="clear-keys">Clear all keys</button>
      </fieldset>

      <fieldset>
        <legend>Research question</legend>
        <label for="question">Your question</label>
        <textarea id="question" rows="3" placeholder="Is a burrito a sandwich?"></textarea>

        <div class="checkbox-row">
          <input type="checkbox" id="append-template" checked />
          <label for="append-template">
            Append &ldquo;One word answer.&rdquo; — this is what makes the compliance metric
            meaningful
          </label>
        </div>

        <p class="preview-label">Exactly what will be sent:</p>
        <pre id="prompt-preview" class="prompt-preview">(nothing yet)</pre>
      </fieldset>

      <fieldset>
        <legend>Models</legend>
        <div id="model-choices" class="model-choices"></div>
      </fieldset>

      <fieldset>
        <legend>Sampling</legend>
        <label for="samples">Samples per model</label>
        <input type="number" id="samples" value="3" min="1" max="5" />
        <p class="field-note">
          More samples give a more reliable majority verdict and cost proportionally more.
        </p>
      </fieldset>

      <p class="submit-row">
        <button type="submit">Run benchmark</button>
      </p>
    </form>

    <p id="run-status" class="run-status" role="status" aria-live="polite"></p>
    <div id="run-output"></div>
  </section>

  <script>
    import '../../run/app.ts'
  </script>
</Base>

<style>
  .lede {
    font-size: var(--step-1);
    color: var(--muted);
  }

  .commitments li {
    margin-bottom: var(--space-2xs);
  }

  .cli-alternative {
    margin-block: var(--space-l);
  }

  .cli-alternative summary {
    cursor: pointer;
    color: var(--muted);
  }

  .run-app {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 3px solid var(--text-strong);
  }

  .identity-row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-bottom: var(--space-m);
  }

  .identity-row p {
    margin: 0;
  }

  fieldset {
    border: var(--hairline) solid var(--rule);
    padding: var(--space-m);
    margin-bottom: var(--space-m);
  }

  legend {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
    padding-inline: var(--space-2xs);
  }

  label {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-3xs);
  }

  .field-note {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0;
  }

  input[type='password'],
  input[type='number'],
  textarea {
    font: inherit;
    width: 100%;
    max-width: 32rem;
    padding: var(--space-2xs);
    background: var(--surface);
    color: var(--text);
    border: var(--hairline) solid var(--rule-strong);
    border-radius: var(--radius);
  }

  .key-fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-s);
    margin-bottom: var(--space-s);
  }

  .checkbox-row,
  .model-choice {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin-block: var(--space-2xs);
  }

  .checkbox-row label,
  .model-choice label {
    margin: 0;
    color: var(--text);
  }

  .prompt-preview {
    white-space: pre-wrap;
    margin-top: var(--space-3xs);
  }

  .preview-label {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 0;
  }

  button {
    font: inherit;
    padding: var(--space-2xs) var(--space-s);
    background: var(--primary);
    color: var(--on-primary);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }

  #clear-keys,
  #sign-out {
    background: var(--surface);
    color: var(--text);
    border: var(--hairline) solid var(--rule-strong);
  }

  .run-status {
    min-height: 1.5em;
    font-size: var(--step--1);
    color: var(--text-strong);
    font-weight: 600;
  }
</style>

<style is:global>
  /* Applied to markup the client script generates, so it cannot be scoped. */
  .unofficial-banner {
    padding: var(--space-s);
    background: var(--surface-sunken);
    border-left: 3px solid var(--accent);
    margin-bottom: var(--space-m);
  }

  .unofficial-banner p {
    margin: 0;
  }

  .run-actions {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
  }
</style>
