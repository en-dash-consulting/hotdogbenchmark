---
/**
 * The reports landing page: the issue rack.
 *
 * One card per question, built from the latest edition, that sells the report
 * before the click: the verdict, who changed their mind, who was surest and
 * who was fastest, and the ways in. The home page is the hook; this is where
 * the hook points.
 */
import Base from '../../layouts/Base.astro'
import AskQuestion from '../../components/AskQuestion.astro'
import {
  getAllRuns,
  getLatestRun,
  getModelResults,
  getModels,
  getProposedQuestions,
  getQuestions,
  getSite,
  hasData,
} from '../../lib/data.ts'
import { creditLine } from '../../../schema/questions.ts'
import { nextEdition, nextEditionLine } from '../../lib/next-edition.ts'
import { formatDate, formatEdition } from '../../lib/format.ts'
import { consensusOf, framingLabel, questionHeadline } from '../../lib/prose.ts'
import {
  count,
  flippedNames,
  nameList,
  reportsIndexDescription,
  tallyPhrase,
  breadcrumbJsonLd,
} from '../../lib/seo.ts'
import { questionShifts, treatedConditions } from '../../lib/sensitivity.ts'
import { routes } from '../../lib/urls.ts'
import type { Verdict } from '../../../schema/run.ts'

const questions = getQuestions()
const proposed = getProposedQuestions()
const latest = getLatestRun()
const upcoming = nextEditionLine(
  nextEdition(latest?.finishedAt ?? null, getSite().schedule, new Date()),
)
const editions = getAllRuns().length
const models = getModels().length

const VERDICT_WORD: Record<Verdict, string> = { yes: 'Yes', no: 'No', other: 'Hmm' }

const cards = questions.map((question, index) => {
  const results = latest ? getModelResults(latest, question.id) : []
  const consensus = consensusOf(results)
  const compared = latest
    ? questionShifts(latest, question.id).filter((row) =>
        row.cells.some((cell) => cell.shift.status !== 'incomparable'),
      ).length
    : 0
  const flipped = latest ? flippedNames(latest, question.id) : []
  const framings = latest
    ? treatedConditions(latest).filter((condition) =>
        latest.results.some(
          (cell) => cell.questionId === question.id && cell.conditionId === condition.id,
        ),
      )
    : []
  return {
    question,
    number: String(index + 1).padStart(2, '0'),
    asked: results.length > 0,
    consensus,
    tally: tallyPhrase(results),
    minds:
      compared === 0
        ? null
        : flipped.length === 0
          ? `Told the answer, nobody changed their mind.`
          : `Told the answer, ${nameList(flipped, 3)} changed their ${flipped.length === 1 ? 'mind' : 'minds'}.`,
    framings,
  }
})

/**
 * Contested questions first: the ones the field split on are the reason to
 * read a report. Settled ones, where every model agreed, follow as a shorter
 * rack. A group with nothing in it is not rendered.
 */
const groups = [
  {
    id: 'contested',
    title: 'Contested',
    note: 'the field split',
    cards: cards.filter((card) => card.asked && !card.consensus.unanimous),
  },
  {
    id: 'settled',
    title: 'Settled',
    note: 'every model agreed',
    cards: cards.filter((card) => card.asked && card.consensus.unanimous),
  },
  {
    id: 'unasked',
    title: 'Not in this edition',
    note: '',
    cards: cards.filter((card) => !card.asked),
  },
].filter((group) => group.cards.length > 0)
---

<Base
  title="The reports"
  ogImage="reports"
  description={reportsIndexDescription(latest, questions)}
  jsonLd={breadcrumbJsonLd(Astro.site ?? new URL('http://localhost:4321'), [
    { name: 'Home', path: routes.home() },
    { name: 'Reports', path: routes.reports() },
  ])}
>
  <header class="rack-head">
    <p class="eyebrow">The reports</p>
    <h1>One straight-faced report per question.</h1>
    {
      latest ? (
        <p class="lede">
          {count(questions.length, 'question')}, {models} models,{' '}
          {treatedConditions(latest).length + 1} framings, {count(editions, 'edition')} so far.
          Verdicts, latency, tokens, cost, framing sensitivity, and every verbatim answer. Latest:{' '}
          {formatEdition(latest.isoWeek)}, {formatDate(latest.finishedAt)}. {upcoming} Subscribe by{' '}
          <a href={routes.feedRss()} type="application/rss+xml">
            RSS
          </a>{' '}
          or{' '}
          <a href={routes.feedJson()} type="application/json">
            JSON feed
          </a>
          .
        </p>
      ) : (
        <p class="lede">
          No edition has been published yet. The reports appear with the first run.
        </p>
      )
    }
  </header>

  {
    hasData() && latest ? (
      <>
        {groups.map((group) => (
          <section class="rack-group" aria-labelledby={`${group.id}-heading`}>
            <h2 id={`${group.id}-heading`} class="rack-group-title">
              {group.title} <span class="rack-group-note">{group.note}</span>
            </h2>
            <ol class="rack">
              {group.cards.map((card) => (
                <li class="issue" data-verdict={card.consensus.verdict ?? 'none'}>
                  <p class="issue-number tabular" aria-hidden="true">
                    {card.number}
                  </p>
                  <h3 class="issue-title">
                    <a href={routes.report(card.question.id)}>{questionHeadline(card.question)}</a>
                  </h3>
                  {card.asked ? (
                    <>
                      <p class="issue-verdict">
                        <span class="verdict-word">
                          {card.consensus.verdict ? VERDICT_WORD[card.consensus.verdict] : 'Split'}
                        </span>
                        <span class="verdict-tally">{card.tally}.</span>
                      </p>
                      {card.minds && <p class="issue-minds">{card.minds}</p>}
                      <p class="issue-links">
                        <a class="issue-cta" href={routes.report(card.question.id)}>
                          Read the report →
                        </a>
                        {card.framings.map((condition) => (
                          <a href={routes.reportCondition(card.question.id, condition.id)}>
                            {framingLabel(card.question, condition)}
                          </a>
                        ))}
                        <a href={routes.reportPdf(card.question.id)}>PDF</a>
                        <a href={routes.historyForQuestion(card.question.id)}>Week by week</a>
                      </p>
                    </>
                  ) : (
                    <p class="issue-verdict">
                      <span class="verdict-tally">
                        Not asked in the {formatEdition(latest.isoWeek)} edition.
                      </span>
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </>
    ) : null
  }

  {
    proposed.length > 0 && (
      <section class="up-next" aria-labelledby="up-next-heading">
        <p class="eyebrow">Up next</p>
        <h2 id="up-next-heading">Accepted, not yet asked.</h2>
        <p class="lede">
          {proposed.length === 1
            ? 'One question has been accepted and joins the next edition it is switched on for.'
            : `${proposed.length} questions have been accepted and join the next edition they are switched on for.`}
        </p>
        <ul class="up-next-list">
          {proposed.map((question) => (
            <li class="up-next-card">
              <p class="up-next-question">{questionHeadline(question)}</p>
              {question.tagline && <p class="up-next-tagline">{question.tagline}</p>}
              {creditLine(question) && (
                <p class="up-next-credit">
                  {question.contributor?.url ? (
                    <>
                      Sent in by{' '}
                      <a target="_blank" href={question.contributor.url} rel="nofollow noopener">
                        {question.contributor.name}
                      </a>
                    </>
                  ) : (
                    creditLine(question)
                  )}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <AskQuestion />

  <p class="rack-foot">
    Every edition, and each question week by week, is under{' '}
    <a href={routes.runs()}>Editions</a>. The scores are defined on{' '}
    <a href={routes.methodology()}>the methodology page</a>.
  </p>
</Base>

<style>
  .rack-head {
    max-width: var(--measure);
    margin-bottom: var(--space-xl);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-2xs);
  }

  .rack-head h1 {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 var(--space-s);
  }

  .lede {
    font-family: var(--font-text);
    color: var(--muted);
    margin: 0;
  }

  .rack-group {
    margin-top: var(--space-xl);
  }

  .rack-group-title {
    font-size: var(--step-2);
    margin: 0 0 var(--space-s);
  }

  .rack-group-note {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  /* A grid, not a column: the rack has to hold twenty questions as well as three. */
  .rack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-m);
  }

  .issue {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--surface);
    border: 2px solid var(--rule-strong);
    border-left-width: 0.4rem;
    border-left-color: var(--issue-color);
  }

  /* The edge says what the field said, in the badges' own colors: teal for
     yes, orange for no, purple for a hedge, and the plain rule when the
     field is split. A decorative color per card read as a status. */
  .issue {
    --issue-color: var(--rule-strong);
  }

  .issue[data-verdict='yes'] {
    --issue-color: var(--accent-fill);
  }

  .issue[data-verdict='no'] {
    --issue-color: var(--orange);
  }

  .issue[data-verdict='other'] {
    --issue-color: var(--purple);
  }

  .issue-number {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .issue-title {
    margin: 0;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .issue-title a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .issue-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--issue-color);
    text-decoration-thickness: 0.12em;
  }

  .issue-verdict {
    margin: var(--space-2xs) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
  }

  .verdict-word {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--text-strong);
  }

  .verdict-tally,
  .issue-minds {
    font-family: var(--font-text);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .issue-minds {
    margin: 0;
  }

  .issue-links {
    margin: auto 0 0;
    padding-top: var(--space-2xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-s);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .issue-links a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
  }

  .issue-cta {
    padding: 0 var(--space-s);
    border-radius: 999px;
    background: var(--text-strong);
    color: var(--surface);
    text-decoration: none;
  }

  .issue-cta:hover {
    background: var(--surface);
    color: var(--text-strong);
    box-shadow: inset 0 0 0 2px var(--text-strong);
  }

  .rack-foot {
    margin-top: var(--space-xl);
    color: var(--muted);
    font-family: var(--font-text);
  }

  @media (forced-colors: active) {
    .issue-cta {
      border: 2px solid ButtonText;
      background: ButtonFace !important;
      color: ButtonText !important;
      forced-color-adjust: none;
    }

    .issue {
      border-left-color: CanvasText;
    }
  }

  .up-next {
    margin-top: var(--space-2xl);
  }

  .up-next h2 {
    margin: 0 0 var(--space-2xs);
  }

  .up-next .lede {
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }

  .up-next-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-s);
  }

  .up-next-card {
    padding: var(--space-m);
    background: var(--surface);
    border-top: 3px solid var(--rule-strong);
  }

  .up-next-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .up-next-tagline {
    margin: var(--space-2xs) 0 0;
    font-family: var(--font-text);
    color: var(--muted);
  }

  .up-next-credit {
    margin: var(--space-s) 0 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-strong);
  }
</style>
