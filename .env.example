# Copy this file to .env and fill in the keys you have.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. You do NOT need any of these
# to work on the project: `npm run bench -- run --mock` runs the entire pipeline
# from recorded fixtures with no keys and no network.
#
# In CI these are GitHub Actions repository secrets, not a file. See SECURITY.md.
# Per-provider free tiers, rate limits and expected weekly cost: docs/providers.md


# --- Provider API keys -------------------------------------------------------
# One per provider. Missing keys are skipped with a warning; the run continues.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# xAI (Grok) — https://console.x.ai/
XAI_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Meta Llama via a hosting provider — https://api.together.ai/settings/api-keys
# (The model is Meta's; the latency you measure is Together's. Groq was the
# other candidate but moved its Llama models to enterprise-only pricing in
# June 2026. See the methodology page.)
TOGETHER_API_KEY=


# --- Runner tuning -----------------------------------------------------------
# All optional; the defaults below are what the weekly job uses.

# Samples per model per question. Medians come from these, so 1 gives you no
# protection against a single slow response skewing the numbers.
BENCH_SAMPLES=3

# How many model x question jobs run at once. Never more than one in-flight
# request per provider regardless of this value, to avoid rate-limit skew.
BENCH_CONCURRENCY=3

# Per-request timeout in milliseconds.
BENCH_TIMEOUT_MS=60000

# Edition cadence: "week" (one file per ISO week, the default) or "day" (one
# file per UTC date, for forks that want a denser record). A daily schedule
# makes seven runs where the weekly one makes one, so at the same sample count
# it costs seven times as much. --cadence on the command line overrides this.
# BENCH_CADENCE=week

# Set to any value to make mock-mode timings deterministic, for tests and for
# diffing two mock runs against each other.
# BENCH_SEED=1


# --- Site build --------------------------------------------------------------

# Override the deployed site origin. Leave unset for GitHub Pages project pages;
# set it when serving from a custom domain.
# SITE_URL=https://hotdogbenchmark.example

# Emit the deferred "run your own benchmark" page. Off by default.
# When unset or not exactly "true", the page is not built at all and no nav
# entry appears — it is absent from dist/, not hidden.
# RUN_YOUR_OWN_ENABLED=true

# Where the bring-your-own-keys proxy is deployed. Only used when the flag
# above is on. See docs/proxy.md.
# PROXY_ORIGIN=https://hotdogbenchmark-proxy.workers.dev
