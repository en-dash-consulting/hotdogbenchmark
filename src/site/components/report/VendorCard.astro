---
/**
 * One model's entry in the report: the answer, the numbers, and the shape.
 *
 * This is the scorecard and the profile in one card, so a model appears once
 * in the roster rather than twice. An `article` with a heading, so a
 * screen-reader user can navigate model by model rather than wading through
 * an undifferentiated grid, and the anchor every chart mark links to.
 *
 * The radar plots only the axes that vary across the field this edition. A
 * spoke every model maxes carries no information, and five identical
 * pentagons in a row tell the reader nothing except that a chart was drawn.
 * Every axis stays in the table under the radar, with the uniform ones named.
 *
 * Every metric renders, including the ones that are null: those show an em
 * dash with a reason, because "not reported" and "zero" are different facts
 * and the report is careful about that everywhere else too.
 */
import VerdictBadge from './VerdictBadge.astro'
import { RADAR_AXIS_LABELS, radarAxes, uniformMeasures } from '../../lib/scores.ts'
import { vendorVerdictLine } from '../../lib/prose.ts'
import { polarPoint, polygonPath } from '../../lib/scale.ts'
import {
  formatDuration,
  formatInteger,
  formatPercent,
  formatRate,
  formatUsd,
} from '../../lib/format.ts'
import { getModelEntry } from '../../lib/data.ts'
import { profileAnchor } from '../../lib/urls.ts'
import type { ModelResult } from '../../../schema/run.ts'

interface Props {
  result: ModelResult
  peers: ModelResult[]
  headingLevel?: 'h3' | 'h4'
}

const { result, peers, headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
const entry = getModelEntry(result.provider, result.modelId)
const aggregate = result.aggregate
const answered = result.samples.length > 0

const answer = result.samples[0]?.text ?? null

/** Metric rows. `note` explains a dash rather than leaving it unexplained. */
const metrics: Array<{ label: string; value: string; note?: string }> = [
  { label: 'Input tokens', value: formatInteger(aggregate.inputTokens?.median) },
  { label: 'Output tokens', value: formatInteger(aggregate.outputTokens?.median) },
  { label: 'Latency', value: formatDuration(aggregate.totalMs?.median) },
  {
    label: 'First token',
    value: formatDuration(aggregate.ttfbMs?.median),
    note: aggregate.ttfbMs == null ? 'not reported' : undefined,
  },
  { label: 'Throughput', value: formatRate(aggregate.tokensPerSecond?.median) },
  {
    label: 'Cost',
    value: formatUsd(aggregate.costEstimateUsd),
    note: aggregate.costEstimateUsd == null ? 'no pricing' : undefined,
  },
]

// The radar.
const SIZE = 120
const CENTER = { x: SIZE / 2, y: SIZE / 2 }
const RADIUS = 42

const axes = radarAxes(result, peers)
const uniform = uniformMeasures(peers).radar
const allKeys = Object.keys(RADAR_AXIS_LABELS) as Array<keyof typeof RADAR_AXIS_LABELS>
const keys = allKeys.filter((key) => !uniform.has(key))
// Two points are a line, not a shape. Below three varying axes the table
// carries the values on its own.
const drawRadar = answered && keys.length >= 3

const shape = polygonPath(
  keys.map((key, index) => polarPoint(CENTER, RADIUS * axes[key], index, keys.length)),
)
const outline = polygonPath(keys.map((_, index) => polarPoint(CENTER, RADIUS, index, keys.length)))
const midline = polygonPath(
  keys.map((_, index) => polarPoint(CENTER, RADIUS * 0.5, index, keys.length)),
)

const verdictLine = answered ? vendorVerdictLine(result, peers) : ''
const summary = `Radar chart for ${result.displayName}. ${keys
  .map((key) => `${RADAR_AXIS_LABELS[key]} ${formatPercent(axes[key])}`)
  .join(', ')}.`
const tableId = `radar-${result.provider}-${result.modelId}`.replace(/[^a-zA-Z0-9-]/g, '-')
---

<article
  id={profileAnchor(result)}
  class:list={['profile', result.status === 'error' && 'profile-error']}
  tabindex="-1"
>
  <div class="profile-head">
    <div>
      <p class="vendor">{entry?.vendor ?? result.provider}</p>
      <Heading class="model-name">{result.displayName}</Heading>
      <p class="model-id tabular">{result.modelId}</p>
    </div>
    <VerdictBadge verdict={aggregate.verdict} />
  </div>

  {
    result.status === 'error' ? (
      <div class="error-state">
        <p class="error-category">{result.error?.category.replace('_', ' ') ?? 'unavailable'}</p>
        <p class="error-message">{result.error?.message ?? 'No response was returned.'}</p>
        <p class="error-note">
          No metrics are reported for this provider in this edition. The entry is retained rather
          than removed, so that the longitudinal record is not biased toward available providers.
        </p>
      </div>
    ) : (
      <>
        {answer !== null && (
          <blockquote class="answer">
            <p>{answer}</p>
          </blockquote>
        )}

        <div class="shape">
          {drawRadar && (
            <svg
              viewBox={`0 0 ${SIZE} ${SIZE}`}
              width={SIZE}
              height={SIZE}
              role="img"
              aria-label={summary}
            >
              <path d={outline} fill="none" stroke="var(--rule-strong)" stroke-width="1" />
              <path d={midline} fill="none" stroke="var(--chart-grid)" stroke-width="1" />
              {keys.map((_, index) => {
                const point = polarPoint(CENTER, RADIUS, index, keys.length)
                return (
                  <line
                    x1={CENTER.x}
                    y1={CENTER.y}
                    x2={point.x}
                    y2={point.y}
                    stroke="var(--chart-grid)"
                    stroke-width="1"
                  />
                )
              })}
              <path
                d={shape}
                fill="var(--chart-1)"
                fill-opacity="0.25"
                stroke="var(--chart-1)"
                stroke-width="1.5"
              />
              {keys.map((key, index) => {
                const point = polarPoint(CENTER, RADIUS * axes[key], index, keys.length)
                return (
                  <circle class="radar-dot" cx={point.x} cy={point.y} r="2.5" fill="var(--chart-1)">
                    <title>
                      {RADAR_AXIS_LABELS[key]}: {formatPercent(axes[key])}
                    </title>
                  </circle>
                )
              })}
            </svg>
          )}

          <table id={tableId} class="axes">
            <caption class="visually-hidden">{result.displayName} scorecard axes</caption>
            <tbody>
              {keys.map((key) => (
                <tr>
                  <th scope="row">{RADAR_AXIS_LABELS[key]}</th>
                  <td class="numeric">{formatPercent(axes[key])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {uniform.size > 0 && (
          <p class="axis-note">
            {[...uniform]
              .map((key) => `${RADAR_AXIS_LABELS[key].toLowerCase()} ${formatPercent(axes[key])}`)
              .join(', ')}{' '}
            for every model, so not on the radar.
          </p>
        )}

        <dl class="metrics">
          {metrics.map((metric) => (
            <div class="metric-row">
              <dt>{metric.label}</dt>
              <dd class="tabular">
                {metric.value}
                {metric.note && <span class="metric-note"> {metric.note}</span>}
              </dd>
            </div>
          ))}
        </dl>

        <p class="verdict-line">{verdictLine}</p>

        {result.status === 'partial' && (
          <p class="partial-note">
            Partial data: {aggregate.sampleCount} of the requested samples completed.
            {result.error && ` Last error: ${result.error.message}`}
          </p>
        )}
      </>
    )
  }
</article>

<style>
  .profile:target {
    outline: 3px solid var(--accent-fill);
    outline-offset: 4px;
  }

  .profile {
    padding: var(--space-s);
    background: var(--surface);
    border-top: var(--hairline) solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .profile-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .vendor {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
  }

  .model-name {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step-1);
  }

  .model-id {
    margin: var(--space-3xs) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
    overflow-wrap: anywhere;
  }

  .answer {
    margin: 0;
    padding: var(--space-2xs) var(--space-s);
    border-left: 3px solid var(--rule-strong);
    background: var(--surface-sunken);
  }

  .answer p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-strong);
  }

  .shape {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
  }

  .shape svg {
    flex: 0 0 auto;
  }

  .radar-dot {
    transition: r 150ms var(--ease-pop);
  }

  .radar-dot:hover {
    r: 5;
    stroke: var(--accent-fill);
    stroke-width: 2;
  }

  .axes {
    flex: 1 1 9rem;
    min-width: 0;
    width: auto;
    font-size: var(--step--1);
  }

  .axes th,
  .axes td {
    padding-block: 0.15rem;
  }

  .axes th {
    font-weight: 400;
    color: var(--muted);
    padding-left: 0;
  }

  .axis-note {
    margin: 0;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--faint);
  }

  /* Two columns of label-and-value pairs: eight rows in the height of four. */
  .metrics {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(8.5rem, 100%), 1fr));
    column-gap: var(--space-m);
    row-gap: 0;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding-block: var(--space-3xs);
    border-bottom: var(--hairline) solid var(--rule);
    font-size: var(--step--1);
    min-width: 0;
  }

  .metric-row dt {
    color: var(--muted);
    white-space: nowrap;
  }

  .metric-row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .metric-note {
    font-weight: 400;
    color: var(--faint);
    font-style: italic;
  }

  .verdict-line {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text);
    font-style: italic;
  }

  .error-state {
    padding: var(--space-s);
    background: var(--error-bg);
    border-left: 3px solid var(--error);
  }

  .error-category {
    margin: 0;
    font-weight: 600;
    color: var(--error);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
  }

  .error-message {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step--1);
  }

  .error-note {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .partial-note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
