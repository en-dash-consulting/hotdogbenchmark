---
/**
 * The layout every page uses.
 *
 * Structure is landmark-first: skip link, header/nav, main, footer. Exactly one
 * h1 per page, supplied by the page rather than by this layout.
 *
 * The theme script is inline and pre-hydration on purpose — see the comment on
 * it below.
 */
import '../styles/global.css'
import { getLatestRun } from '../lib/data.ts'
import { formatDate, formatEdition } from '../lib/format.ts'
import { REPO_URL, RUN_YOUR_OWN_ENABLED, routes } from '../lib/urls.ts'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title: string
  description: string
  /** Rendered in the <title> as "<title> — Sandwich Classification Benchmark". */
  bareTitle?: boolean
  /** Name of a card under /og/, without the extension. Defaults to the site card. */
  ogImage?: string
}

const { title, description, bareTitle = false, ogImage = 'default' } = Astro.props

const SITE_NAME = 'Sandwich Classification Benchmark'
const fullTitle = bareTitle ? title : `${title} — ${SITE_NAME}`

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href
// OpenGraph requires an absolute URL; a relative one is silently ignored by
// every card validator, which is a slow way to find out it is wrong.
const ogImageUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/${ogImage}.png`,
  Astro.site ?? 'http://localhost:4321',
).href
const latest = getLatestRun()

const NAV = [
  { href: routes.home(), label: 'Reports' },
  { href: routes.history(), label: 'History' },
  // Only present when the deferred feature is switched on at build time.
  ...(RUN_YOUR_OWN_ENABLED ? [{ href: routes.runYourOwn(), label: 'Run your own' }] : []),
  { href: routes.methodology(), label: 'Methodology' },
  { href: routes.howItWorks(), label: 'How it works' },
  { href: routes.about(), label: 'About' },
]

/** Trailing slashes are normalized so `/history` and `/history/` both match. */
const current = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === current
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The En Dash faces: Montserrat for headings and interface, Merriweather for prose. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400..900;1,400..900&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Sandwich Classification Benchmark`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/json"
      title="Weekly editions"
      href={routes.feedJson()}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Weekly editions"
      href={routes.feedRss()}
    />

    {
      /*
      Runs before first paint, which is the entire point. Applying a stored
      theme after hydration produces a flash of the wrong theme on every page
      load, and there is no way to avoid that from an external script. It is
      deliberately tiny and wrapped in try/catch because localStorage throws
      outright in some privacy modes.
    */
    }
    <script is:inline>
      try {
        const stored = localStorage.getItem('hdb-theme')
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored
        }
      } catch {
        /* No stored preference available; the system preference applies. */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="masthead">
      <div class="container masthead-inner">
        <a class="wordmark" href={routes.home()}>
          <span class="brand" aria-label="En Dash">
            <span class="brand-en">en</span><span class="brand-dash">DASH</span>
          </span>
          <span class="wordmark-name">Sandwich Classification Benchmark</span>
        </a>

        <div class="masthead-controls">
          <nav aria-label="Primary">
            <ul class="nav-list">
              {
                NAV.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <ThemeToggle />
        </div>
      </div>
      <div class="brand-line"></div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="rule"></div>
        <div class="footer-grid">
          <p class="footer-meta">
            {
              latest ? (
                <>
                  Data as of <strong>{formatEdition(latest.isoWeek)}</strong>, published{' '}
                  {formatDate(latest.finishedAt)}.
                  {latest.isMock && <span class="footer-mock"> Sample data.</span>}
                </>
              ) : (
                <>No editions published yet.</>
              )
            }
          </p>
          <p class="footer-links">
            <a href={REPO_URL}>Source on GitHub</a>
            <span aria-hidden="true"> · </span>
            <a href={routes.methodology()}>Methodology</a>
            <span aria-hidden="true"> · </span>
            <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT licence</a>
          </p>
        </div>
        <p class="footer-note">
          An <a href="https://endash.us">En Dash Consulting</a> research programme of no consequence whatsoever,
          published weekly. The questions are silly on purpose; the measurement is not. See <a
            href={routes.about()}>About</a
          >.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead {
    background: var(--surface);
  }

  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m) var(--space-s);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    text-decoration: none;
    color: inherit;
  }

  /* The En Dash mark: "en" carrying the dash, "DASH" in italic. */
  .brand {
    font-family: var(--font-text);
    font-weight: 900;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    color: var(--text-strong);
    line-height: 1;
    white-space: nowrap;
  }

  .brand-en {
    border-bottom: 4px solid var(--accent-fill);
    padding-bottom: 0.05em;
  }

  .brand-dash {
    font-style: italic;
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .brand-line {
    height: 4px;
    background: linear-gradient(90deg, var(--accent-fill) 0%, #7bffea 100%);
  }

  .masthead-controls {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  .nav-list a {
    color: var(--muted);
    text-decoration: none;
    padding-block: var(--space-3xs);
    border-bottom: 2px solid transparent;
  }

  .nav-list a:hover {
    color: var(--text-strong);
  }

  /* The current page is marked by weight and a rule, not by colour alone. */
  .nav-list a[aria-current='page'] {
    color: var(--text-strong);
    font-weight: 700;
    border-bottom-color: var(--accent-fill);
  }

  .nav-list {
    font-weight: 600;
  }

  main {
    padding-block: var(--space-xl) var(--space-2xl);
    min-height: 60vh;
  }

  .site-footer {
    background: var(--surface);
    padding-block: var(--space-l) var(--space-xl);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .footer-meta,
  .footer-links {
    margin: 0;
  }

  .footer-mock {
    color: var(--accent);
    font-weight: 600;
  }

  .footer-note {
    margin: var(--space-m) 0 0;
    max-width: var(--measure);
    color: var(--faint);
  }

  /* At 320px the masthead stacks rather than overflowing. */
  @media (max-width: 40rem) {
    .masthead-inner {
      align-items: flex-start;
    }

    .masthead-controls {
      width: 100%;
      justify-content: space-between;
      gap: var(--space-s);
    }

    .nav-list {
      gap: var(--space-s);
    }
  }
</style>
