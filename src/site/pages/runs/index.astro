---
/**
 * Editions: every edition, newest first, and each question week by week.
 *
 * The one archive. The table is the index; the list under it is the
 * substance, one line per edition per question, so a reader (or a crawler)
 * gets the verdicts without opening anything. The per-question history pages
 * are reached from here, so a trend is one click from the editions that make
 * it.
 */
import Base from '../../layouts/Base.astro'
import { getAllRuns, getModelResults, getQuestion, getQuestions } from '../../lib/data.ts'
import { formatDate, formatEdition } from '../../lib/format.ts'
import { runsIndexDescription, subjectName, tallyPhrase } from '../../lib/seo.ts'
import { routes } from '../../lib/urls.ts'
import { formatCost, runCost } from '../../lib/cost.ts'

const runs = getAllRuns()
const questions = getQuestions()

const modelCount = (run: (typeof runs)[number]) =>
  new Set(run.results.flatMap((r) => r.models.map((m) => `${m.provider}/${m.modelId}`))).size
---

<Base title="Editions" description={runsIndexDescription(runs)}>
  <h1>Every week, asked again.</h1>
  <p class="muted">
    Newest first. An edition is never revised after it is published. The cost is the sum of every
    call's estimate from the dated price table, so the bill for asking is a number, not a guess.
  </p>

  {
    runs.length === 0 ? (
      <p>No editions have been published yet.</p>
    ) : (
      <>
        <div
          class="table-scroll"
          tabindex="0"
          role="region"
          aria-label="Table, scrolls sideways on narrow screens"
        >
          <table>
            <caption class="visually-hidden">Published editions</caption>
            <thead>
              <tr>
                <th scope="col">Edition</th>
                <th scope="col">Published</th>
                <th scope="col" class="numeric">
                  Questions
                </th>
                <th scope="col" class="numeric">
                  Models
                </th>
                <th scope="col" class="numeric">
                  Est. cost
                </th>
                <th scope="col">Notes</th>
              </tr>
            </thead>
            <tbody>
              {runs.map((run) => (
                <tr>
                  <th scope="row">
                    <a href={routes.run(run.isoWeek)}>{formatEdition(run.isoWeek)}</a>
                  </th>
                  <td>{formatDate(run.finishedAt)}</td>
                  <td class="numeric">{run.questions.length}</td>
                  <td class="numeric">{modelCount(run)}</td>
                  <td class="numeric">{formatCost(runCost(run))}</td>
                  <td>{run.isMock ? 'Sample data' : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <section class="by-question" aria-labelledby="by-question-heading">
          <h2 id="by-question-heading">Each question, week by week</h2>
          <p class="muted">
            {runs.length === 1
              ? 'One edition so far: each page shows how consistent every model was with itself. Trends begin with the second edition.'
              : 'How every model has answered across editions: verdict share, latency, tokens and framing sensitivity over time.'}
          </p>
          <ul class="question-list">
            {questions.map((question) => (
              <li>
                <a href={routes.historyForQuestion(question.id)}>
                  {question.reportTitle}, week by week
                </a>
                <p class="muted">{question.tagline ?? question.text}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="findings" aria-labelledby="findings-heading">
          <h2 id="findings-heading">What each edition found</h2>
          <p class="muted">
            The control tally per question: the question asked plainly, no system prompt. The framed
            arms and every model's answer are in the edition itself.
          </p>
          {runs.map((run) => (
            <article class="edition">
              <h3>
                <a href={routes.run(run.isoWeek)}>{formatEdition(run.isoWeek)}</a>
              </h3>
              <p class="edition-meta">
                Published {formatDate(run.finishedAt)}. {modelCount(run)} models,{' '}
                {run.conditions.length} framings, {run.questions.length} questions.
                {run.isMock && <strong> Sample data.</strong>}
              </p>
              <ul>
                {run.questions.map((asked) => {
                  const question = getQuestion(asked.id)
                  const results = getModelResults(run, asked.id)
                  return (
                    <li>
                      <a href={routes.runQuestion(run.isoWeek, asked.id)}>
                        {question ? subjectName(question) : asked.id}
                      </a>
                      : {tallyPhrase(results, 'said')}.
                    </li>
                  )
                })}
              </ul>
            </article>
          ))}
        </section>
      </>
    )
  }
</Base>

<style>
  .by-question,
  .findings {
    margin-top: var(--space-2xl);
    max-width: var(--measure);
  }

  .question-list {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 0;
  }

  .question-list li + li {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: var(--hairline) solid var(--rule);
  }

  .question-list a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
  }

  .question-list p {
    margin: var(--space-3xs) 0 0;
  }

  .edition {
    margin-top: var(--space-l);
  }

  .edition h3 {
    margin: 0 0 var(--space-2xs);
  }

  .edition-meta {
    margin: 0 0 var(--space-xs);
    color: var(--muted);
  }

  .edition ul {
    margin: 0;
    padding-left: 1.25em;
  }
</style>
