---
/**
 * One question under one non-control framing, for the latest edition: the
 * comparison against the control.
 *
 * The control report is the canonical document. This page is the diff: the
 * masthead with the system prompt as sent, the field's position under each,
 * then every model beside itself with its verbatim answers, whether it moved,
 * and what the framing cost in time and tokens. It does not repeat the
 * quadrant, the standings or the profiles, which are the control's and would
 * be nearly identical here.
 */
import Base from '../../../layouts/Base.astro'
import Masthead from '../../../components/report/Masthead.astro'
import ArmComparison from '../../../components/report/ArmComparison.astro'
import ConditionNav from '../../../components/report/ConditionNav.astro'
import { getLatestRun, getQuestionResult, getQuestions } from '../../../lib/data.ts'
import { treatedConditions } from '../../../lib/sensitivity.ts'
import { formatEdition } from '../../../lib/format.ts'
import { breadcrumbJsonLd, framingDescription } from '../../../lib/seo.ts'
import { routes } from '../../../lib/urls.ts'

export function getStaticPaths() {
  const run = getLatestRun()
  if (!run) return []
  return getQuestions().flatMap((question) =>
    treatedConditions(run)
      .filter((condition) => getQuestionResult(run, question.id, condition.id) !== null)
      .map((condition) => ({
        params: { questionId: question.id, conditionId: condition.id },
        props: { question, condition, run },
      })),
  )
}

const { question, condition, run } = Astro.props
const cell = getQuestionResult(run, question.id, condition.id)!
const results = cell.models
---

<Base
  title={`${question.reportTitle} — ${condition.label} framing`}
  ogImage={`${question.id}-${condition.id}`}
  description={framingDescription(run, question, condition, cell.systemPrompt)}
  jsonLd={breadcrumbJsonLd(Astro.site ?? new URL('http://localhost:4321'), [
    { name: 'Home', path: routes.home() },
    { name: 'Reports', path: routes.reports() },
    { name: question.reportTitle, path: routes.report(question.id) },
    { name: `${condition.label} framing`, path: routes.reportCondition(question.id, condition.id) },
  ])}
>
  <ConditionNav run={run} questionId={question.id} current={condition.id} />
  <Masthead
    question={question}
    run={run}
    questionText={cell.prompt}
    condition={condition}
    systemPrompt={cell.systemPrompt}
  />

  {
    results.length === 0 ? (
      <p class="empty">
        No model produced data under this framing in the {formatEdition(run.isoWeek)} edition.
      </p>
    ) : (
      <ArmComparison
        run={run}
        question={question}
        condition={condition}
        systemPrompt={cell.systemPrompt}
      />
    )
  }
</Base>

<style>
  .empty {
    padding: var(--space-l);
    background: var(--surface);
    border-left: 3px solid var(--rule-strong);
    color: var(--muted);
  }
</style>
