{
  "compilerOptions": {
    // Node 22 runs TypeScript directly by stripping types. That means the code
    // must never use syntax that needs real compilation (enums, namespaces,
    // parameter properties) and that relative imports carry a .ts extension.
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Strictness. noUncheckedIndexedAccess is what makes array and record
    // lookups honest about possibly being undefined.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "src/site/.astro"]
}
