---
/**
 * The front page.
 *
 * One question, asked live. Then how differently the models think, and how
 * easily they change their minds. As little prose as the joke can survive.
 */
import Base from '../layouts/Base.astro'
import AnswerBoard from '../components/AnswerBoard.astro'
import {
  getAllRuns,
  getLatestRun,
  getModelResults,
  getModels,
  getQuestions,
  hasData,
} from '../lib/data.ts'
import { formatDate, formatEdition, formatPercent } from '../lib/format.ts'
import { questionHeadline } from '../lib/prose.ts'
import { count, faqPageJsonLd, homeDescription, homeTitle, webSiteJsonLd } from '../lib/seo.ts'
import { editionSensitivity, hasConditions, modelsInRun } from '../lib/sensitivity.ts'
import { twinPairs, twinsWorthShowing } from '../lib/twins.ts'
import { REPO_URL, profileAnchor, routes, sourceUrl } from '../lib/urls.ts'
import type { Verdict } from '../../schema/run.ts'

const questions = getQuestions()
const latest = getLatestRun()
const editions = getAllRuns().length

/** The query people type, then the promise; the count is the registry's. */
const title = homeTitle(questions[0] ?? null, getModels().length)
const description = homeDescription(latest, questions)
const jsonLd = [
  webSiteJsonLd(Astro.site ?? new URL('http://localhost:4321'), description),
  ...(latest ? [faqPageJsonLd(latest, questions)] : []),
]

const asked = latest
  ? questions.filter((q) => latest.results.some((cell) => cell.questionId === q.id))
  : []

/** Every model's control verdict on every question: the alignment grid. */
const grid = latest
  ? modelsInRun(latest).map((model) => ({
      model,
      verdicts: asked.map((question) => {
        const result = getModelResults(latest, question.id).find(
          (r) => r.provider === model.provider && r.modelId === model.modelId,
        )
        return {
          question,
          verdict: result?.aggregate.verdict ?? null,
          ok: Boolean(result?.samples.length),
        }
      }),
    }))
  : []

/** Agreement per question: share of answering models holding the majority. */
const agreement = asked.map((question) => {
  const verdicts = grid.map(
    (row) => row.verdicts.find((v) => v.question.id === question.id)?.verdict ?? null,
  )
  const counts: Record<Verdict, number> = { yes: 0, no: 0, other: 0 }
  for (const v of verdicts) if (v) counts[v] += 1
  const total = counts.yes + counts.no + counts.other
  const top = Math.max(counts.yes, counts.no, counts.other)
  return { question, share: total ? top / total : 0, total, counts }
})

/**
 * Pairs of models that gave the same verdict on every shared question, shown
 * only when that is selective: with three questions most pairs agree.
 */
const twins = twinPairs(
  grid.map((row) => ({
    name: row.model.displayName,
    verdicts: row.verdicts.map((v) => v.verdict),
  })),
)
const showTwins = twinsWorthShowing(twins.length, grid.length, asked.length)

const sensitivity =
  latest && hasConditions(latest)
    ? editionSensitivity(latest)
        .filter((entry) => entry.overall.comparable > 0)
        .sort((a, b) => (b.overall.score ?? 0) - (a.overall.score ?? 0))
    : []

const GLYPH: Record<Verdict, string> = { yes: 'Yes', no: 'No', other: 'Hmm' }

/** Kept as a string so the formatter cannot fold the line breaks out of a <pre>. */
const QUICKSTART = [
  `git clone ${REPO_URL}.git`,
  'cd hotdogbenchmark && npm install',
  'npm run bench -- run --mock --out tmp/mock-run.json',
  'npm run dev',
].join('\n')
---

<Base title={title} description={description} jsonLd={jsonLd} flush>
  {
    hasData() && latest ? (
      <>
        <AnswerBoard run={latest} questions={asked} />

        <section class="minds" aria-labelledby="minds-heading">
          <div class="minds-head">
            <p class="eyebrow">Same question, different minds</p>
            <h2 id="minds-heading">They do not agree with each other.</h2>
          </div>

          <div
            class="grid-wrap table-scroll"
            tabindex="0"
            role="region"
            aria-label="Table, scrolls sideways on narrow screens"
          >
            <table class="align-grid">
              <caption class="visually-hidden">
                Each model's majority answer to each question, {formatEdition(latest.isoWeek)}
              </caption>
              <thead>
                <tr>
                  <th scope="col">
                    <span class="visually-hidden">Model</span>
                  </th>
                  {asked.map((q) => (
                    <th scope="col">
                      <a href={routes.report(q.id)}>{q.subject.replace(/^an? /, '')}</a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {grid.map((row) => (
                  <tr>
                    <th scope="row">{row.model.displayName}</th>
                    {row.verdicts.map((cell) => (
                      <td>
                        <a
                          class:list={['dot', cell.verdict ? `dot-${cell.verdict}` : 'dot-none']}
                          href={`${routes.report(cell.question.id)}#${profileAnchor(row.model)}`}
                          title={`${row.model.displayName} on ${cell.question.subject}: ${cell.verdict ?? 'no data'}. Open its profile in the report.`}
                        >
                          {cell.verdict ? GLYPH[cell.verdict] : '—'}
                        </a>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">Agreement</th>
                  {agreement.map((a) => (
                    <td>
                      <span class="agree tabular">{a.total ? formatPercent(a.share) : '—'}</span>
                    </td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>

          {showTwins && (
            <p class="twins">
              Thinking alike:{' '}
              {twins
                .slice(0, 3)
                .map((pair) => pair.join(' & '))
                .join(' · ')}
              {twins.length > 3 && ` · and ${twins.length - 3} more pairs`}
            </p>
          )}

          {asked.length > 0 && (
            <p class="handoff-line">
              <a class="handoff-cta" href={routes.reports()}>
                Read the {count(asked.length, 'report')} →
              </a>
              <span class="handoff-note">
                One straight-faced analyst report per question: standings, the certainty quadrant,
                every verbatim answer under every framing, and a PDF for each.
              </span>
            </p>
          )}
        </section>

        {sensitivity.length > 0 && (
          <section class="minds minds-alt" aria-labelledby="sway-heading">
            <div class="minds-head">
              <p class="eyebrow">Tell them the answer</p>
              <h2 id="sway-heading">Some of them believe you.</h2>
              <p class="minds-note">
                Share of questions where a model changed its answer once a system prompt stated the
                answer as fact. Holding firm and following instructions are both defensible; the{' '}
                <a href={`${routes.methodology()}#sensitivity`}>methodology</a> grades neither.
              </p>
            </div>
            <ol class="sway">
              {sensitivity.map((entry) => (
                <li class="sway-row">
                  <span class="sway-name">{entry.model.displayName}</span>
                  <span class="sway-bar" aria-hidden="true">
                    <i style={`width:${Math.round((entry.overall.score ?? 0) * 100)}%`} />
                  </span>
                  <span class="sway-value tabular">
                    {formatPercent(entry.overall.score)}
                    <small>
                      {entry.overall.moved} of {entry.overall.comparable}
                    </small>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section class="reports" aria-labelledby="fork-heading">
          <div class="fork">
            <div class="fork-copy">
              <p class="eyebrow">Open source</p>
              <h2 id="fork-heading">Point it at your own question.</h2>
              <p>
                One repo, MIT-licensed: adapters for every provider, the framings, the site. Clone
                it, swap the question, add whatever keys you have, and you get the same cross-model,
                cross-framing analysis for cents. Pull requests welcome.
              </p>
              <p class="fork-links">
                <a href={REPO_URL}>GitHub</a>
                <span aria-hidden="true"> · </span>
                <a href={sourceUrl('docs/self-hosting.md')}>Self-hosting</a>
                <span aria-hidden="true"> · </span>
                <a href={routes.addAModel()}>Add a model</a>
                <span aria-hidden="true"> · </span>
                <a href={sourceUrl('CONTRIBUTING.md')}>Contributing</a>
              </p>
            </div>
            <pre
              class="fork-code"
              aria-label="Quickstart commands"
              tabindex="0"
              set:text={QUICKSTART}
            />
          </div>

          <p class="edition-line">
            {formatEdition(latest.isoWeek)} · published {formatDate(latest.finishedAt)} ·{' '}
            <a href={routes.runs()}>
              {editions === 1 ? 'one edition' : `${editions} editions`} so far
            </a>
            {latest.isMock && <strong class="mock"> · sample data</strong>}
          </p>
        </section>
      </>
    ) : (
      <section class="empty">
        <h1>{questions[0] ? questionHeadline(questions[0]) : 'Nothing asked yet.'}</h1>
        <p>
          No editions have been published yet. Run <code>npm run bench -- run --mock</code>.
        </p>
      </section>
    )
  }
</Base>

<style>
  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-2xs);
  }

  .minds {
    margin-block: var(--space-3xl);
  }

  .minds-head {
    max-width: var(--measure);
    margin-bottom: var(--space-l);
  }

  .minds-head h2 {
    font-size: var(--step-4);
    margin: 0;
  }

  .minds-note {
    margin: var(--space-s) 0 0;
    color: var(--muted);
  }

  /* --- Alignment grid ------------------------------------------------------ */
  .align-grid {
    border-collapse: separate;
    border-spacing: 0 var(--space-2xs);
    width: auto;
    min-width: min(100%, 40rem);
  }

  .align-grid th,
  .align-grid td {
    border: 0;
    padding: var(--space-2xs) var(--space-s);
    text-align: center;
    vertical-align: middle;
  }

  .align-grid thead th {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    text-transform: capitalize;
    letter-spacing: -0.02em;
  }

  .align-grid thead th a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .align-grid thead th a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent-fill);
    text-decoration-thickness: 3px;
  }

  .align-grid tbody th,
  .align-grid tfoot th {
    text-align: left;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    transition: transform 150ms var(--ease-pop);
  }

  .dot {
    text-decoration: none;
  }

  tr:hover .dot,
  .dot:focus-visible {
    transform: scale(1.08);
  }

  .dot:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .dot-yes {
    background: var(--accent-fill);
    color: #001769;
  }

  /* Navy ink on the brand orange and teal: white on orange is only 3:1. */
  .dot-no {
    background: var(--orange);
    color: #001769;
  }

  .dot-other {
    background: var(--purple);
    color: #ffffff;
  }

  .dot-none {
    background: var(--surface-sunken);
    color: var(--faint);
  }

  .align-grid tfoot td {
    border-top: 2px solid var(--text-strong);
    padding-top: var(--space-s);
  }

  .align-grid tfoot th {
    border-top: 2px solid var(--text-strong);
    padding-top: var(--space-s);
    color: var(--muted);
    font-weight: 600;
  }

  .agree {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--text-strong);
  }

  .twins {
    margin: var(--space-m) 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--muted);
  }

  /* --- Sway bars ----------------------------------------------------------- */
  .minds-alt {
    padding: var(--space-xl) var(--space-l);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .sway {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    max-width: 48rem;
  }

  .sway-row {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr auto;
    gap: var(--space-s);
    align-items: center;
  }

  .sway-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-strong);
  }

  .sway-bar {
    display: block;
    height: 1.25rem;
    background: var(--surface-sunken);
    border-radius: 999px;
    overflow: hidden;
  }

  .sway-bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--purple) 0%, #8a70ff 100%);
    border-radius: 999px;
    min-width: 0.25rem;
    transform-origin: left;
    animation: grow 900ms var(--ease-out) backwards;
  }

  .sway-value {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--text-strong);
    line-height: 1;
    min-width: 5ch;
  }

  .sway-value small {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sway-bar i {
      animation: none;
    }
  }

  /* --- The hand-off line ------------------------------------------------- */
  .handoff-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin: var(--space-l) 0 0;
    padding-top: var(--space-m);
    border-top: 3px solid var(--text-strong);
  }

  .handoff-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-m);
    border-radius: 999px;
    background: var(--primary);
    color: var(--on-primary);
    font-family: var(--font-ui);
    font-weight: 700;
    text-decoration: none;
  }

  .handoff-cta:hover {
    background: var(--accent-fill);
    color: #001769;
  }

  .handoff-note {
    font-family: var(--font-text);
    color: var(--muted);
    max-width: 48ch;
  }

  @media (forced-colors: active) {
    .handoff-cta {
      border: 2px solid ButtonText;
      background: ButtonFace !important;
      color: ButtonText !important;
      forced-color-adjust: none;
    }
  }

  .reports {
    margin-block: var(--space-3xl);
  }

  .fork {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-xl);
    border-radius: var(--radius);
    background: linear-gradient(135deg, #000b45 0%, #120c3f 100%);
    color: #ffffff;
  }

  .fork .eyebrow {
    color: var(--accent-fill);
  }

  .fork h2 {
    color: #ffffff;
    font-size: var(--step-3);
    margin: 0 0 var(--space-s);
  }

  .fork-copy p {
    color: #d5d9ee;
    max-width: 48ch;
  }

  .fork-links a {
    color: #ffffff;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .fork-code {
    margin: 0;
    padding: var(--space-m);
    background: rgb(0 0 0 / 35%);
    border: 1px solid rgb(123 255 234 / 35%);
    border-radius: var(--radius-sm);
    color: #7bffea;
    font-size: var(--step--1);
    line-height: 1.7;
    overflow-x: auto;
  }

  .edition-line {
    margin-top: var(--space-l);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .mock {
    color: var(--accent);
  }

  .empty {
    padding-block: var(--space-2xl);
  }
</style>
