---
/**
 * Framing sensitivity per model, per condition, as grouped horizontal bars.
 *
 * One row per model, one bar per non-control arm, each bar's length the share
 * of questions on which the model's position moved. Every bar carries its
 * value as a direct label and each arm has its own fill pattern, so the chart
 * reads without color and in forced-colors mode.
 *
 * A model with nothing comparable under an arm gets no bar and a note, not a
 * bar of zero length — "could not be compared" and "never moved" are
 * different facts.
 */
import ChartFrame from './ChartFrame.astro'
import { formatPercent } from '../../lib/format.ts'
import { round } from '../../lib/scale.ts'
import { profileAnchor } from '../../lib/urls.ts'
import type { ModelSensitivity } from '../../lib/sensitivity.ts'
import type { RunCondition } from '../../../schema/run.ts'

interface Props {
  entries: ModelSensitivity[]
  conditions: RunCondition[]
  title: string
  caption?: string
}

const { entries, conditions, title, caption } = Astro.props

const PATTERNS = ['sens-solid', 'sens-diagonal', 'sens-cross', 'sens-dots']
const COLORS = ['var(--chart-1)', 'var(--chart-2)', 'var(--chart-3)', 'var(--chart-4)']

const ROW_HEIGHT = 18
const ROW_GAP = 10
const GROUP_GAP = 14
const LABEL_WIDTH = 160
const VALUE_WIDTH = 56
const WIDTH = 720

const groupHeight = conditions.length * ROW_HEIGHT + (conditions.length - 1) * ROW_GAP
const plotTop = 8
const height = plotTop + entries.length * (groupHeight + GROUP_GAP) + 8
const barMax = WIDTH - LABEL_WIDTH - VALUE_WIDTH - 16

const rows = entries.map((entry, index) => ({
  entry,
  y: plotTop + index * (groupHeight + GROUP_GAP),
  bars: conditions.map((condition, armIndex) => {
    const score = entry.byCondition.find((c) => c.condition.id === condition.id)?.score ?? null
    return {
      condition,
      score,
      y: plotTop + index * (groupHeight + GROUP_GAP) + armIndex * (ROW_HEIGHT + ROW_GAP),
      width: score?.score == null ? 0 : round(score.score * barMax),
      arm: armIndex,
      pattern: PATTERNS[armIndex % PATTERNS.length]!,
      color: COLORS[armIndex % COLORS.length]!,
    }
  }),
}))

const mostSensitive = [...entries]
  .filter((e) => e.overall.score !== null)
  .sort((a, b) => b.overall.score! - a.overall.score!)[0]
const summary =
  entries.length === 0
    ? 'Bar chart of framing sensitivity: no models to compare.'
    : `Bar chart of framing sensitivity for ${entries.length} models across ${conditions.length} conditions. ` +
      (mostSensitive
        ? `${mostSensitive.model.displayName} moved most often, on ${formatPercent(mostSensitive.overall.score)} of comparable questions overall.`
        : 'No model could be compared.') +
      ' Values are in the accompanying table.'
---

<ChartFrame title={title} summary={summary} caption={caption}>
  <svg viewBox={`0 0 ${WIDTH} ${height}`} width={WIDTH} height={height}>
    <defs>
      <pattern id="sens-solid" width="6" height="6" patternUnits="userSpaceOnUse">
        <rect width="6" height="6" fill={COLORS[0]}></rect>
      </pattern>
      <pattern
        id="sens-diagonal"
        width="6"
        height="6"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect width="6" height="6" fill={COLORS[1]}></rect>
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--surface)" stroke-width="2"></line>
      </pattern>
      <pattern id="sens-cross" width="6" height="6" patternUnits="userSpaceOnUse">
        <rect width="6" height="6" fill={COLORS[2]}></rect>
        <line x1="0" y1="3" x2="6" y2="3" stroke="var(--surface)" stroke-width="1.5"></line>
        <line x1="3" y1="0" x2="3" y2="6" stroke="var(--surface)" stroke-width="1.5"></line>
      </pattern>
      <pattern id="sens-dots" width="6" height="6" patternUnits="userSpaceOnUse">
        <rect width="6" height="6" fill={COLORS[3]}></rect>
        <circle cx="3" cy="3" r="1.4" fill="var(--surface)"></circle>
      </pattern>
    </defs>

    {/* The full-scale guide, so a short bar is visibly short. */}
    <line
      x1={LABEL_WIDTH + barMax}
      y1={plotTop - 4}
      x2={LABEL_WIDTH + barMax}
      y2={height - 4}
      stroke="var(--chart-grid)"
      stroke-width="1"
      stroke-dasharray="3 3"></line>
    <line
      x1={LABEL_WIDTH}
      y1={plotTop - 4}
      x2={LABEL_WIDTH}
      y2={height - 4}
      stroke="var(--chart-axis)"
      stroke-width="1"></line>

    {
      rows.map((row) => (
        <a class="mark" href={`#${profileAnchor(row.entry.model)}`}>
          <title>
            {row.entry.model.displayName}:{' '}
            {row.bars
              .map((bar) =>
                bar.score?.score == null
                  ? `${bar.condition.label} not comparable`
                  : `${bar.condition.label} ${formatPercent(bar.score.score)}`,
              )
              .join(', ')}
            . Jump to its profile.
          </title>
          <text
            x={LABEL_WIDTH - 10}
            y={round(row.y + groupHeight / 2 + 4)}
            text-anchor="end"
            class="model-label"
          >
            {row.entry.model.displayName}
          </text>
          {row.bars.map((bar) => (
            <g>
              {bar.score?.score == null ? (
                <text x={LABEL_WIDTH + 6} y={bar.y + 13} class="note-label">
                  not comparable
                </text>
              ) : (
                <>
                  <rect
                    class={`sens-bar sens-bar-${bar.arm}`}
                    x={LABEL_WIDTH}
                    y={bar.y}
                    width={Math.max(bar.width, 0)}
                    height={ROW_HEIGHT}
                    fill={`url(#${bar.pattern})`}
                  />
                  <text
                    x={LABEL_WIDTH + Math.max(bar.width, 0) + 6}
                    y={bar.y + 13}
                    class="value-label"
                  >
                    {formatPercent(bar.score.score)}
                    <tspan class="arm-label"> {bar.condition.label.toLowerCase()}</tspan>
                  </text>
                </>
              )}
            </g>
          ))}
        </a>
      ))
    }
  </svg>

  <table slot="table">
    <caption>{title} — data</caption>
    <thead>
      <tr>
        <th scope="col">Vendor</th>
        {
          conditions.map((condition) => (
            <th scope="col" class="numeric">
              {condition.label}
            </th>
          ))
        }
        <th scope="col" class="numeric">Overall</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((entry) => (
          <tr>
            <th scope="row">{entry.model.displayName}</th>
            {entry.byCondition.map(({ score }) => (
              <td class="numeric">
                {score.score === null
                  ? 'not comparable'
                  : `${formatPercent(score.score)} (${score.moved} of ${score.comparable})`}
              </td>
            ))}
            <td class="numeric">
              {entry.overall.score === null
                ? 'not comparable'
                : `${formatPercent(entry.overall.score)} (${entry.overall.moved} of ${entry.overall.comparable})`}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</ChartFrame>

<ul class="legend">
  {
    conditions.map((condition, index) => (
      <li>
        <span
          class="swatch"
          style={`background: ${COLORS[index % COLORS.length]}`}
          aria-hidden="true"
        />
        {condition.label}
      </li>
    ))
  }
</ul>

<style>
  .model-label {
    font-size: 12px;
    fill: var(--text-strong);
  }

  .mark {
    cursor: pointer;
    outline: none;
  }

  .mark:hover .model-label,
  .mark:focus-visible .model-label {
    text-decoration: underline;
    font-weight: 700;
  }

  .mark:hover rect,
  .mark:focus-visible rect {
    stroke: var(--text-strong);
    stroke-width: 2;
  }

  .mark:focus-visible .model-label {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .value-label {
    font-size: 11px;
    font-weight: 600;
    fill: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .arm-label {
    font-weight: 400;
    fill: var(--muted);
  }

  .note-label {
    font-size: 11px;
    fill: var(--faint);
    font-style: italic;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
    margin: calc(-1 * var(--space-m)) 0 var(--space-l);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .swatch {
    width: 0.75em;
    height: 0.75em;
    display: inline-block;
    border: var(--hairline) solid var(--rule-strong);
  }
</style>
