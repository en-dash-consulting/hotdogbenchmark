---
/**
 * The Framing Sensitivity section: what happened to each vendor's position
 * when the question was asked under a system prompt that stated the answer.
 *
 * Three views of the same cells, from headline to evidence:
 *
 *   1. The prose summary and the arms as actually sent for this question.
 *   2. A position matrix — every model's verdict under every arm, with the
 *      ones that moved marked by a word as well as a fill, so the table reads
 *      without color.
 *   3. The verbatim answers, per model, per arm, behind a `<details>` each.
 *      This is the evidence: a reader can see the exact words a model used
 *      under each framing without a line of client JavaScript.
 *
 * The edition-wide chart at the end applies the measure across every
 * question, since a single question can only ever score 0 or 1.
 *
 * Renders nothing at all when the edition ran only the control.
 */
import VerdictBadge from './VerdictBadge.astro'
import SensitivityBars from '../charts/SensitivityBars.astro'
import { framingSummary } from '../../lib/prose.ts'
import {
  editionSensitivity,
  hasConditions,
  questionShifts,
  replayedFromControl,
  treatedConditions,
} from '../../lib/sensitivity.ts'
import { getQuestionResult } from '../../lib/data.ts'
import { formatPercent } from '../../lib/format.ts'
import { routes } from '../../lib/urls.ts'
import type { BenchmarkRun, ModelResult } from '../../../schema/run.ts'
import type { QuestionEntry } from '../../../schema/questions.ts'

interface Props {
  run: BenchmarkRun
  question: QuestionEntry
}

const { run, question } = Astro.props

const enabled = hasConditions(run)
const arms = enabled ? treatedConditions(run) : []
const rows = enabled ? questionShifts(run, question.id) : []
const summary = enabled ? framingSummary(run, question.id, question.subject) : ''
const edition = enabled ? editionSensitivity(run) : []

/** The system prompt as actually sent for this question under an arm. */
const promptFor = (conditionId: string) =>
  getQuestionResult(run, question.id, conditionId)?.systemPrompt ?? null

/** What a model said, and how consistently, in one arm. */
function said(result: ModelResult | null): { text: string; agreement: string } | null {
  if (!result || result.samples.length === 0 || replayedFromControl(result)) return null
  const majority = result.aggregate.verdict
  const agreeing = result.samples.filter((s) => s.verdict === majority).length
  const first = result.samples.find((s) => s.verdict === majority) ?? result.samples[0]!
  return {
    text: first.text,
    agreement:
      result.samples.length === 1
        ? 'single sample'
        : `${agreeing} of ${result.samples.length} samples`,
  }
}

const movedCount = rows.filter((row) => row.movedAnywhere).length
const comparableCount = rows.filter((row) =>
  row.cells.some((cell) => cell.shift.status !== 'incomparable'),
).length
---

{
  enabled && (
    <section aria-labelledby="framing-heading" class="framing" data-framing>
      <h2 id="framing-heading">Framing sensitivity</h2>
      <p class="framing-lede">
        We also asked each model with a system prompt that stated the answer as fact, and watched
        what happened. <strong>Changing your mind is not worse than holding firm here</strong>: one
        is following instructions, the other is ignoring a false premise, and we are not grading
        either.
      </p>

      <ul class="framing-kpis">
        <li>
          <p class="kpi-label">Changed position</p>
          <p class="kpi-value tabular">
            {movedCount} <span class="kpi-of">of {comparableCount}</span>
          </p>
          <p class="kpi-sub">comparable models, under at least one framing</p>
        </li>
        {arms.map((arm) => {
          const moved = rows.filter(
            (row) => row.cells.find((c) => c.condition.id === arm.id)?.shift.status === 'moved',
          ).length
          const comparable = rows.filter(
            (row) =>
              row.cells.find((c) => c.condition.id === arm.id)?.shift.status !== 'incomparable',
          ).length
          return (
            <li>
              <p class="kpi-label">Moved when {arm.label.toLowerCase()}</p>
              <p class="kpi-value tabular">
                {moved} <span class="kpi-of">of {comparable}</span>
              </p>
              <p class="kpi-sub">
                {comparable === 0 ? 'no comparable models' : formatPercent(moved / comparable)}
              </p>
            </li>
          )
        })}
      </ul>

      <p class="framing-summary">{summary}</p>

      {/* The explorer's controls. Hidden until the script that makes them work has run. */}
      <div class="explorer" data-explorer hidden>
        <div class="explorer-group" role="group" aria-label="Show">
          <span class="explorer-label">Show</span>
          <button type="button" data-show="all" aria-pressed="true">
            All
          </button>
          <button type="button" data-show="moved" aria-pressed="false">
            Changed their mind
          </button>
          <button type="button" data-show="held" aria-pressed="false">
            Held firm
          </button>
        </div>
        <div class="explorer-group">
          <span class="explorer-label">Focus</span>
          <span class="explorer-focus" data-focus-name>
            none: pick a vendor in the table
          </span>
          <button type="button" data-clear-focus hidden>
            Clear
          </button>
        </div>
        <p class="explorer-status" role="status" data-explorer-status />
      </div>

      <h3>The framings, as sent</h3>
      <dl class="arms">
        {arms.map((arm) => (
          <div class="arm">
            <dt>
              {arm.label}
              <a class="arm-link" href={routes.reportCondition(question.id, arm.id)}>
                full report under this framing →
              </a>
            </dt>
            <dd>
              {promptFor(arm.id) ? (
                <p class="arm-prompt">
                  <span class="arm-prompt-label">System prompt</span>
                  <q>{promptFor(arm.id)}</q>
                </p>
              ) : (
                <p class="arm-prompt muted">No system prompt.</p>
              )}
              <p class="arm-description">{arm.description}</p>
            </dd>
          </div>
        ))}
      </dl>

      <h3>Position by framing</h3>
      <div class="table-scroll">
        <table class="shift-table">
          <caption>
            Each model's majority verdict on {question.subject} under the control and under each
            framing. Cells that differ from the control are marked.
          </caption>
          <thead>
            <tr>
              <th scope="col">Vendor</th>
              <th scope="col">Control</th>
              {arms.map((arm) => (
                <th scope="col">{arm.label}</th>
              ))}
              <th scope="col">Assessment</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const movedUnder = row.cells
                .filter((c) => c.shift.status === 'moved')
                .map((c) => c.condition.label.toLowerCase())
              const comparable = row.cells.some((c) => c.shift.status !== 'incomparable')
              return (
                <tr
                  class:list={[row.movedAnywhere && 'row-moved']}
                  data-vendor={`${row.model.provider}/${row.model.modelId}`}
                  data-moved={row.movedAnywhere ? 'true' : 'false'}
                  data-comparable={comparable ? 'true' : 'false'}
                >
                  <th scope="row">
                    <span
                      class="vendor-name"
                      data-focus={`${row.model.provider}/${row.model.modelId}`}
                    >
                      {row.model.displayName}
                    </span>
                  </th>
                  <td>
                    <VerdictBadge verdict={row.control?.aggregate.verdict ?? null} />
                  </td>
                  {row.cells.map((cell) => (
                    <td class:list={['shift-cell', cell.shift.status]}>
                      {replayedFromControl(cell.result) ? (
                        <span class="not-recorded">Not recorded</span>
                      ) : (
                        <VerdictBadge verdict={cell.result?.aggregate.verdict ?? null} />
                      )}
                      {cell.shift.status === 'moved' && <span class="shift-mark">moved</span>}
                    </td>
                  ))}
                  <td class="assessment">
                    {!comparable
                      ? 'Not comparable'
                      : movedUnder.length === 0
                        ? 'Held under every framing'
                        : `Moved when ${movedUnder.join(' and ')}`}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>

      <h3>What each vendor said, verbatim</h3>
      <p class="muted verbatim-note">
        Exactly what each model said under each framing. Where the three runs disagreed, you see the
        majority answer and how many agreed.
      </p>
      <ul class="verbatim-list">
        {rows.map((row) => {
          const control = said(row.control)
          return (
            <li
              data-vendor={`${row.model.provider}/${row.model.modelId}`}
              data-moved={row.movedAnywhere ? 'true' : 'false'}
              data-comparable={
                row.cells.some((c) => c.shift.status !== 'incomparable') ? 'true' : 'false'
              }
            >
              <details class="verbatim" data-verbatim>
                <summary>
                  <span class="verbatim-name">{row.model.displayName}</span>
                  <span class="verbatim-status">
                    {row.movedAnywhere
                      ? 'changed position'
                      : row.cells.some((c) => c.shift.status !== 'incomparable')
                        ? 'held position'
                        : 'not comparable'}
                  </span>
                </summary>
                <dl class="verbatim-body">
                  <div class="verbatim-row">
                    <dt>
                      Control <span class="verbatim-context">no system prompt</span>
                    </dt>
                    <dd>
                      {control ? (
                        <>
                          <blockquote class="answer">
                            <p>{control.text}</p>
                          </blockquote>
                          <p class="verbatim-meta">
                            <VerdictBadge verdict={row.control?.aggregate.verdict ?? null} />
                            <span>{control.agreement}</span>
                          </p>
                        </>
                      ) : (
                        <p class="verbatim-meta muted">No usable response.</p>
                      )}
                    </dd>
                  </div>
                  {row.cells.map((cell) => {
                    const answer = said(cell.result)
                    return (
                      <div class:list={['verbatim-row', cell.shift.status]}>
                        <dt>
                          {cell.condition.label}{' '}
                          {promptFor(cell.condition.id) && (
                            <span class="verbatim-context">
                              told <q>{promptFor(cell.condition.id)}</q>
                            </span>
                          )}
                        </dt>
                        <dd>
                          {answer ? (
                            <>
                              <blockquote class="answer">
                                <p>{answer.text}</p>
                              </blockquote>
                              <p class="verbatim-meta">
                                <VerdictBadge verdict={cell.result?.aggregate.verdict ?? null} />
                                <span>{answer.agreement}</span>
                                {cell.shift.status === 'moved' && (
                                  <span class="shift-mark">moved from control</span>
                                )}
                              </p>
                            </>
                          ) : replayedFromControl(cell.result) ? (
                            <p class="verbatim-meta muted">
                              Not recorded under this framing. Sample data replays this provider's
                              control answer here and does not count it as a position.
                            </p>
                          ) : (
                            <p class="verbatim-meta muted">No usable response.</p>
                          )}
                        </dd>
                      </div>
                    )
                  })}
                </dl>
              </details>
            </li>
          )
        })}
      </ul>

      <h3>Across every question this edition</h3>
      <SensitivityBars
        entries={edition}
        conditions={arms}
        title="Framing sensitivity by vendor"
        caption="Share of questions in this edition on which a model's majority verdict under a framing differed from its verdict under the control. Questions where either arm produced no verdict are excluded. Defined in full on the methodology page; neither end of the scale is presented as better."
      />
    </section>
  )
}

<script>
  /**
   * The framing explorer. Everything below is additive: without it the
   * section is complete, and the controls it needs are hidden in the markup.
   *
   * State lives in the URL hash under `focus` and `show`, merged with whatever
   * else is there (the results table keeps its own keys), so a view can be
   * shared.
   */
  const root = document.querySelector<HTMLElement>('[data-framing]')
  const controls = root?.querySelector<HTMLElement>('[data-explorer]')

  if (root && controls) {
    const status = controls.querySelector<HTMLElement>('[data-explorer-status]')!
    const focusName = controls.querySelector<HTMLElement>('[data-focus-name]')!
    const clearButton = controls.querySelector<HTMLButtonElement>('[data-clear-focus]')!
    const showButtons = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-show]'))
    const rows = Array.from(root.querySelectorAll<HTMLElement>('tr[data-vendor], li[data-vendor]'))
    const marks = Array.from(root.querySelectorAll<HTMLElement>('a.mark[data-vendor]'))
    const names = Array.from(root.querySelectorAll<HTMLElement>('[data-focus]'))

    let show: 'all' | 'moved' | 'held' = 'all'
    let focus: string | null = null

    const displayNameOf = (vendor: string) =>
      names.find((n) => n.dataset.focus === vendor)?.textContent?.trim() ?? vendor

    function apply() {
      let visible = 0
      for (const row of rows) {
        const moved = row.dataset.moved === 'true'
        const comparable = row.dataset.comparable === 'true'
        const matches = show === 'all' || (show === 'moved' ? moved : comparable && !moved)
        row.hidden = !matches
        if (matches && row.tagName === 'TR') visible += 1
        const isFocus = focus !== null && row.dataset.vendor === focus
        row.classList.toggle('is-focus', isFocus)
        row.classList.toggle('is-dim', focus !== null && !isFocus)
        if (isFocus) {
          const details = row.querySelector<HTMLDetailsElement>('[data-verbatim]')
          if (details) details.open = true
        }
      }
      for (const mark of marks) {
        const isFocus = focus !== null && mark.dataset.vendor === focus
        mark.classList.toggle('is-focus', isFocus)
        mark.classList.toggle('is-dim', focus !== null && !isFocus)
      }
      for (const name of names) {
        name.setAttribute('aria-pressed', String(name.dataset.focus === focus))
      }
      for (const button of showButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.show === show))
      }
      focusName.textContent =
        focus === null ? 'none: pick a vendor in the table' : displayNameOf(focus)
      clearButton.hidden = focus === null
      status.textContent =
        `${visible} of ${rows.filter((r) => r.tagName === 'TR').length} vendors shown` +
        (focus === null ? '.' : `, focused on ${displayNameOf(focus)}.`)

      const state = new URLSearchParams(location.hash.slice(1))
      if (show === 'all') state.delete('show')
      else state.set('show', show)
      if (focus === null) state.delete('focus')
      else state.set('focus', focus)
      const hash = state.toString()
      history.replaceState(null, '', hash ? `#${hash}` : location.pathname + location.search)
    }

    for (const name of names) {
      name.setAttribute('role', 'button')
      name.tabIndex = 0
      const toggle = () => {
        focus = focus === name.dataset.focus ? null : (name.dataset.focus ?? null)
        apply()
      }
      name.addEventListener('click', toggle)
      name.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          toggle()
        }
      })
    }
    for (const button of showButtons) {
      button.addEventListener('click', () => {
        show = (button.dataset.show as typeof show) ?? 'all'
        apply()
      })
    }
    clearButton.addEventListener('click', () => {
      focus = null
      apply()
    })
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && focus !== null) {
        focus = null
        apply()
      }
    })

    // Restore a shared view.
    const initial = new URLSearchParams(location.hash.slice(1))
    const initialShow = initial.get('show')
    if (initialShow === 'moved' || initialShow === 'held') show = initialShow
    const initialFocus = initial.get('focus')
    if (initialFocus && names.some((n) => n.dataset.focus === initialFocus)) focus = initialFocus

    controls.hidden = false
    apply()
  }
</script>

<style>
  .framing {
    margin-block: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 3px solid var(--text-strong);
  }

  .framing h3 {
    margin-top: var(--space-l);
  }

  .framing-lede {
    max-width: var(--measure);
    font-size: var(--step-0);
    color: var(--muted);
  }

  .framing-lede strong {
    color: var(--text-strong);
  }

  .framing-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-s);
    list-style: none;
    margin: var(--space-m) 0;
    padding: 0;
  }

  .framing-kpis li {
    padding: var(--space-s);
    background: var(--surface);
    border-top: 3px solid var(--accent);
  }

  .kpi-label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 var(--space-2xs);
  }

  .kpi-value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    margin: 0;
    line-height: var(--leading-tight);
  }

  .kpi-of {
    font-size: var(--step-0);
    font-weight: 400;
    color: var(--muted);
  }

  .kpi-sub {
    font-size: var(--step--1);
    color: var(--muted);
    margin: var(--space-3xs) 0 0;
  }

  .framing-summary {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .arms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-s);
    margin: 0;
  }

  .arm {
    padding: var(--space-s) var(--space-m);
    background: var(--surface);
    border-left: 3px solid var(--text-strong);
  }

  .arm dt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
    font-size: var(--step-1);
  }

  .arm-link {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: var(--step--1);
  }

  .arm dd {
    margin: var(--space-2xs) 0 0;
  }

  .arm-prompt {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-strong);
  }

  .arm-prompt-label {
    display: block;
    font-family: var(--font-text);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .arm-description {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* --- Explorer ------------------------------------------------------------ */
  .explorer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin: var(--space-m) 0;
    padding: var(--space-s) var(--space-m);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .explorer-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .explorer-label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: var(--space-2xs);
  }

  .explorer button {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    padding: var(--space-3xs) var(--space-s);
    border: 2px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-strong);
    cursor: pointer;
  }

  .explorer button[aria-pressed='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }

  .explorer-focus {
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--text-strong);
  }

  .explorer-status {
    margin: 0;
    flex-basis: 100%;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .vendor-name[role='button'] {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.2em;
  }

  .vendor-name[role='button']:hover,
  .vendor-name[role='button'][aria-pressed='true'] {
    text-decoration-style: solid;
    text-decoration-color: var(--accent-fill);
    text-decoration-thickness: 3px;
  }

  .vendor-name[role='button']:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  tr.is-focus {
    background: var(--verdict-yes-bg);
  }

  tr.is-dim,
  li.is-dim {
    opacity: 0.45;
  }

  li.is-focus .verbatim {
    border-top: 3px solid var(--accent-fill);
  }

  .shift-table caption {
    text-align: left;
    caption-side: bottom;
    font-size: var(--step--1);
    color: var(--muted);
    padding-top: var(--space-2xs);
  }

  .shift-cell {
    white-space: nowrap;
  }

  .not-recorded {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
  }

  .shift-cell.moved {
    background: var(--surface-sunken);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  /*
   * The word, not the color, is the marker. The accent lives on the cell's
   * inset rule; the text itself stays at full contrast on the sunken surface,
   * where the accent falls short of AA at this size.
   */
  .shift-mark {
    display: inline-block;
    margin-left: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-strong);
  }

  .row-moved th {
    color: var(--text-strong);
  }

  .assessment {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .verbatim-note {
    max-width: var(--measure);
    font-size: var(--step--1);
  }

  .verbatim-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .verbatim {
    border-top: var(--hairline) solid var(--rule);
  }

  .verbatim summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    cursor: pointer;
    list-style: none;
  }

  .verbatim summary::-webkit-details-marker {
    display: none;
  }

  .verbatim summary::before {
    content: '+';
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--muted);
    margin-right: var(--space-2xs);
  }

  .verbatim[open] summary::before {
    content: '−';
  }

  .verbatim summary:hover .verbatim-name {
    text-decoration: underline;
  }

  .verbatim-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
    flex: 1;
  }

  .verbatim-status {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
  }

  .verbatim-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-s);
    margin: 0 0 var(--space-m);
  }

  .verbatim-row {
    padding: var(--space-s);
    background: var(--surface);
    border-top: var(--hairline) solid var(--rule-strong);
  }

